# Ingesta de Frames (ESP32-CAM)
@app.post("/ingest/frame")
@app.post("/frames/ingest")
async def ingest_frame(request: Request, camera_id: str = Form(None),
                       user_id: str = Form("default"), image: UploadFile = File(None)):
    cid = camera_id or "unknown"
    uid = user_id or "default"
    if image is None:
        body = await request.body()
        ct = request.headers.get("content-type", "")
        if "image" in ct and body:
            from io import BytesIO
            image = UploadFile(filename=f"{cid}.jpg", file=BytesIO(body))
        else:
            raise HTTPException(status_code=400, detail="No image provided")
    return await _process_ingest(request, cid, uid, image)

@app.post("/ingest/photo")
@app.post("/ingest/snapshot")
async def ingest_photo(request: Request, filename: str = Form(None),
                       camera_id: str = Form(None), user_id: str = Form(None),
                       image: UploadFile = File(None)):
    cid = camera_id or filename or "unknown"
    uid = user_id or "default"
    if image is None:
        body = await request.body()
        ct = request.headers.get("content-type", "")
        if "image" in ct and body:
            from io import BytesIO
            image = UploadFile(filename=f"{cid}.jpg", file=BytesIO(body))
        else:
            raise HTTPException(status_code=400, detail="No image provided")
    return await _process_ingest(request, cid, uid, image)

@app.post("/ingest/raw")
async def ingest_raw(request: Request):
    """ESP32 envia bytes puros (image/jpeg) con query params camera_id y user_id."""
    try:
        body = await request.body()
        ct = request.headers.get("content-type", "")
        qp = request.query_params
        cid = qp.get("camera_id") or "unknown"
        uid = qp.get("user_id") or "default"
        if not body:
            return {"success": False, "error": "empty body"}
        from io import BytesIO
        fake = UploadFile(filename=f"{cid}.jpg", file=BytesIO(body))
        return await _process_ingest(request, cid, uid, fake)
    except Exception as e:
        logger.error(f"Ingest raw error: {e}")
        return {"success": False, "error": str(e)}

async def _process_ingest(request: Request, camera_id: str, user_id: str, image: UploadFile):
    try:
        client_ip = request.client.host if request.client else "unknown"
        user_id = resolve_user_id(camera_id, user_id, client_ip)
        img_bytes = await image.read()
        frame_size = len(img_bytes)
        logger.info(f"Frame: IP={client_ip} Cam={camera_id} User={user_id} Size={frame_size}B")
        # 1. YOLO detection
        yolo_count = 0
        try:
            async with httpx.AsyncClient(timeout=10) as client:
                yolo_resp = await client.post(
                    "http://localhost:8002/detect",
                    files={"image": ("frame.jpg", img_bytes, "image/jpeg")},
                )
                if yolo_resp.status_code == 200:
                    yolo_count = yolo_resp.json().get("count", 0)
        except Exception as e:
            logger.warning(f"YOLO unavailable: {e}")
        logger.info(f"YOLO: {yolo_count} objects")
        # 2. Agregar al grid SOLO si YOLO detecto objetos
        grid_result = {"frame_count": 0, "grid_full": False, "ready_for_analysis": False}
        if yolo_count > 0:
            v_prompt, v_rules = "", ""
            uf = find_user_json(user_id)
            if uf and uf.exists():
                with open(uf) as f:
                    ud = json.load(f)
                v_prompt = ud.get("vigilance_prompt", "")
                v_rules_raw = ud.get("vigilance_rules", [])
                v_rules = v_rules_raw if isinstance(v_rules_raw, str) else "\n".join(v_rules_raw) if v_rules_raw else ""
            grid_result = orchestrator.add_frame(
                img_bytes, camera_id, user_id,
                yolo_count=yolo_count,
                vigilance_prompt=v_prompt,
                vigilance_rules=v_rules
            )
            logger.info(f"Grid: {grid_result['frame_count']}/16 | YOLO:{yolo_count}")
        else:
            logger.info(f"Skip: no YOLO objects")
        # 3. Registrar camara si es nueva
        if user_id and user_id != "default":
            uf = find_user_json(user_id)
            if uf and uf.exists():
                with open(uf) as f:
                    ud = json.load(f)
                existing_ids = [c.get("camera_id") for c in ud.get("cameras", [])]
                if camera_id not in existing_ids:
                    ud.setdefault("cameras", []).append({
                        "camera_id": camera_id,
                        "name": camera_id,
                        "zone": "",
                        "active": True,
                        "first_seen": int(time.time()),
                        "last_frame": int(time.time())
                    })
                    uf.parent.mkdir(parents=True, exist_ok=True)
                    with open(uf, "w") as f:
                        json.dump(ud, f, indent=2)
                    compat_dir = STORAGE_ROOT / "users" / user_id
                    compat_dir.mkdir(parents=True, exist_ok=True)
                    with open(compat_dir / "user.json", "w") as f:
                        json.dump(ud, f, indent=2)
        return {
            "success": True,
            "camera_id": camera_id,
            "user_id": user_id,
            "client_ip": client_ip,
            "frame_size": frame_size,
            "timestamp": datetime.now().isoformat(),
            "yolo": {"count": yolo_count},
            **grid_result
        }
    except Exception as e:
        logger.error(f"Ingest error: {e}")
        return {"success": False, "error": str(e)}

# Anuncio de Dispositivo
@app.post("/devices/announce")
async def device_announce(request: dict = None):
    if not request:
        request = {}
    camera_id = request.get("camera_id", "unknown")
    user_id = request.get("user_id", "")
    if not camera_id:
        raise HTTPException(status_code=400, detail="camera_id required")
    logger.info(f"Device announce: Cam={camera_id} User={user_id}")
    image_b64 = ""
    frame_bytes = orchestrator.grid.get_last_frame_bytes()
    last_cam = orchestrator.grid.get_last_camera_id()
    if frame_bytes and (last_cam == camera_id or not user_id):
        try:
            resized = resize_image(frame_bytes, max_size=256)
            image_b64 = base64.b64encode(resized).decode()
        except:
            image_b64 = base64.b64encode(frame_bytes).decode()
    if user_id and user_id in eva_sessions:
        s = eva_sessions[user_id]
        s["camera_id"] = camera_id
        s["camera_image_b64"] = image_b64
        s["camera_connected"] = True
        s["phase"] = "esperando_imagen"
        eva_sessions[user_id] = s
    return {
        "success": True,
        "message": f"Camera {camera_id} connected",
        "camera_id": camera_id,
        "image_b64": image_b64,
        "frame_available": bool(frame_bytes)
    }

# ── Chat de Eva v8 — "Camara Primero, Reglas Despues" ─────────────
# Sesiones v8 en memoria
eva_sessions_v8: Dict[str, Dict[str, Any]] = {}

# ── Helpers v8 ──────────────────────────────────────────────────────────

def _load_user_v8(user_id: str) -> dict:
    """Cargar datos del usuario desde disco."""
    for base in [
        STORAGE_ROOT / "users" / user_id / "user.json",
        STORAGE_ROOT / user_id / "user.json",
    ]:
        if base.exists():
            with open(base) as f:
                return json.load(f)
    return {}


def _save_camera_config_v8(user_id: str, config: dict):
    """Guardar camera.json + actualizar user.json."""
    camera_id = config.get("camera_id", "cam_unknown")
    cam_dir = STORAGE_ROOT / "users" / user_id / "cameras" / camera_id
    cam_dir.mkdir(parents=True, exist_ok=True)
    (cam_dir / "sessions").mkdir(exist_ok=True)
    (cam_dir / "frames").mkdir(exist_ok=True)
    (cam_dir / "camera.json").write_text(json.dumps(config, indent=2, ensure_ascii=False))
    # Actualizar user.json
    user_path = STORAGE_ROOT / "users" / user_id / "user.json"
    ud = {}
    if user_path.exists():
        ud = json.loads(user_path.read_text())
        cams = ud.get("cameras", [])
        ids = [c.get("camera_id") for c in cams]
        if camera_id not in ids:
            cams.append({
                "camera_id": camera_id,
                "name": config.get("name", camera_id),
                "zone": config.get("zone", ""),
                "active": True,
            })
            ud["cameras"] = cams
        user_path.write_text(json.dumps(ud, indent=2, ensure_ascii=False))
    # Compat
    compat_dir = STORAGE_ROOT / "users" / user_id
    compat_dir.mkdir(parents=True, exist_ok=True)
    if ud:
        (compat_dir / "user.json").write_text(json.dumps(ud, indent=2, ensure_ascii=False))
    logger.info(f"📷 camera.json guardado: {camera_id} → {cam_dir}")


def _get_frame_v8() -> Optional[bytes]:
    try:
        return orchestrator.grid.get_last_frame_bytes()
    except Exception:
        return None


def _resize_and_encode_v8(img_bytes: bytes, max_size: int = 640) -> str:
    try:
        resized = resize_image(img_bytes, max_size=max_size)
    except Exception:
        resized = img_bytes
    return base64.b64encode(resized).decode()


async def _call_qwen_v8(messages: list, max_tokens: int = 350) -> str:
    try:
        async with httpx.AsyncClient(timeout=90) as client:
            r = await client.post(
                "http://localhost:8004/v1/chat/completions",
                json={"model": "qwen", "messages": messages, "max_tokens": max_tokens}
            )
            if r.status_code == 200:
                return r.json()["choices"][0]["message"]["content"]
    except Exception as e:
        logger.error(f"Qwen error: {e}")
    return "Disculpa, tuve un momento de confusión. ¿Puedes repetir?"


async def _describe_image_v8(img_b64: str) -> str:
    msgs = [{
        "role": "user",
        "content": [
            {"type": "image_url", "image_url": {"url": f"data:image/jpeg;base64,{img_b64}"}},
            {"type": "text", "text": (
                "Describe esta imagen de cámara de seguridad en máximo 50 palabras. "
                "¿Qué zona es? ¿Qué objetos ves? ¿La imagen está nítida? "
                "¿Hay reflejos, zonas oscuras u obstáculos? ¿El ángulo es bueno?"
            )}
        ]
    }]
    return await _call_qwen_v8(msgs, max_tokens=120)


def _extract_signal_v8(text: str) -> Optional[dict]:
    m = re.search(r'\[SIGNAL\](\{.*?\})\[/SIGNAL\]', text, re.DOTALL)
    if m:
        try:
            return json.loads(m.group(1))
        except Exception:
            pass
    return None


def _clean_response_v8(text: str) -> str:
    text = re.sub(r'\[SIGNAL\].*?\[/SIGNAL\]', '', text, flags=re.DOTALL)
    text = re.sub(r'\[CAMERA_CONFIG\].*?\[/CAMERA_CONFIG\]', '', text, flags=re.DOTALL)
    return text.strip()


def _extract_camera_config_v8(text: str) -> Optional[dict]:
    m = re.search(r'\[CAMERA_CONFIG\](\{.*?\})\[/CAMERA_CONFIG\]', text, re.DOTALL)
    if m:
        try:
            return json.loads(m.group(1))
        except Exception:
            pass
    return None


# ── System prompt v8 ────────────────────────────────────────────────────

def _system_prompt_v8(session: dict, phase_instruction: str) -> str:
    owner = session.get("owner", "amigo")
    first = owner.split()[0] if owner else "amigo"
    biz = session.get("biz", "tu negocio")
    biz_type = session.get("biz_type", "negocio")
    schedule = session.get("schedule", {"open": "08:00", "close": "22:00"})
    zone = session.get("zone", "") or "no definida aún"
    rules = session.get("rules", [])
    image_desc = session.get("image_desc", "") or "sin imagen aún"
    rules_str = "\n".join([f"  {i+1}. {r}" for i, r in enumerate(rules)]) if rules else "  (ninguna aún)"
    has_image = bool(session.get("image_b64"))

    return f"""Eres Eva, asistente de seguridad de OjoIA para negocios en República Dominicana.

CONTEXTO:
- Dueño: {owner} (llámalo: {first})
- Negocio: {biz} ({biz_type})
- Horario: {schedule.get('open','08:00')} a {schedule.get('close','22:00')}
- Zona: {zone}
- Imagen disponible: {"SÍ — " + image_desc if has_image else "NO — aún no veo la cámara"}
- Reglas confirmadas: {len(rules)}/3
{rules_str}

REGLAS DE COMPORTAMIENTO:
- Tono dominicano, cercano, directo. Máximo 4 líneas.
- NUNCA: YOLO, grid, scanner, API, JSON, tokens.
- NUNCA propongas reglas si NO hay imagen disponible.
- NUNCA saltes fases: greet → hardware → vision → rules → confirm.
- NUNCA repitas una pregunta que ya respondió el usuario.
- SOLO genera [CAMERA_CONFIG] cuando tengas exactamente 3 reglas confirmadas.

INSTRUCCIÓN ACTUAL (SEGUIR EXACTAMENTE):
{phase_instruction}

CÓMO GENERAR SEÑALES (bloque obligatorio al final de tu respuesta cuando avances):
[SIGNAL]{{"phase": "fase_destino", "zone": "zona_si_la_mencionan", "rule": "regla_exacta_si_confirman"}}[/SIGNAL]

Al final de tu respuesta, si debes avanzar de fase, incluye la señal [SIGNAL] correspondiente. Si no avanzas de fase, NO incluyas ninguna señal."""


# ── Instrucciones por fase v8 ───────────────────────────────────────────

PHASE_INSTRUCTIONS_V8 = {

    "greet": """ESTÁS EN FASE SALUDO.
Si este es el PRIMER contacto (mensaje de bienvenida):
- Saluda a {first} mencionando su negocio ({biz_type}).
- Pregunta: ¿Dónde quieres instalar esta cámara?
- NO generes ningún [SIGNAL]. Solo saluda. Máximo 3 líneas.

Si el usuario YA respondió dónde quiere la cámara:
- Confirma la zona que dijo.
- Genera la señal con la zona REAL que el usuario escribió.
- Ejemplo: si el usuario escribió "en la caja", la señal es: [SIGNAL]{{"phase": "hardware", "zone": "en la caja"}}[/SIGNAL]
- Si escribió "en el mostrador", la señal es: [SIGNAL]{{"phase": "hardware", "zone": "en el mostrador"}}[/SIGNAL]
- NUNCA pongas textos genéricos como "la zona del usuario" o "lo que dijo". Pon el texto EXACTO.""",

    "hardware": """ESTÁS EN FASE HARDWARE. Todavía NO hay imagen. Tu UNICO objetivo es guiar la conexión física.
IMPORTANTE: El usuario te dijo dónde quiere la cámara. NO le preguntes de nuevo. Tú sabes la zona.
SIEMPRE empieza con: "¡Perfecto, {first}! Vamos a conectar la cámara. Enciéndela ahora — la luz del frente va a parpadear. Avísame cuando la veas.""" + "\n" + """
Pasos (UNO por mensaje):
- Paso 1: Pedir que encienda la cámara. Esperar confirmación.
- Paso 2: Pedir que se conecte al WiFi "OjoIA-XXXX" en su celular.
- Paso 3: Pedir que seleccione el WiFi de su negocio y ponga la clave.
- Paso 4: Decir "Espera un momento..." y generar: [SIGNAL]{{"phase": "vision"}}[/SIGNAL]

NO hables de reglas todavía. NO preguntes más sobre la zona. Solo guía la conexión.""",

    "vision": """ESTÁS EN FASE VISIÓN. Ya tienes imagen de la cámara.
Tu objetivo: confirmar la posición Y luego pasar a reglas.

1. Si NO han confirmado la posición aún:
   - Describe brevemente lo que ves (1-2 líneas).
   - Pregunta: "¿Te parece bien esta posición?"
   - Cuando confirmen (sí/bien/ok): responde "Perfecto" y genera:
     [SIGNAL]{{"phase": "rules"}}[/SIGNAL]

2. SI el usuario expresa una preocupación de seguridad (robo, empleados, etc.):
   - NO hables de posición. Pasa directo a reglas.
   - Genera: [SIGNAL]{{"phase": "rules"}}[/SIGNAL]

3. Si piden ajuste de posición: sugiere el ajuste y espera confirmación.

CRÍTICO: NO propongas reglas tú mismo en esta fase. Solo avanza a rules con la señal.""",

    "rules": """ESTÁS EN FASE REGLAS. Ya tienes imagen confirmada. Tienes {rules_count}/3 reglas.
Tu objetivo es configurar exactamente 3 reglas observables de seguridad.

FLUJO OBLIGATORIO:
1. Si {rules_count} == 0: Pregunta "¿Cuál es tu mayor preocupación de seguridad?".
   Si el usuario ya mencionó su preocupación en mensajes anteriores, ve directo al paso 2.

2. Propón UNA regla específica y observable basándote en lo que VES + lo que el usuario te dijo.
   Formato OBLIGATORIO: "Te propongo esta regla: [regla exacta]. ¿Te parece bien o la ajustamos?"

3. Cuando el usuario confirme (sí/ok/perfecto/dale), genera:
   [SIGNAL]{{"phase": "rules", "rule": "la regla EXACTA en español que propusiste"}}[/SIGNAL]

4. Si corrige la regla: ajusta y vuelve a preguntar.

5. Cuando tengas las 3 reglas confirmadas, genera:
   [SIGNAL]{{"phase": "confirm"}}[/SIGNAL]

EJEMPLO de regla buena: "Alerta si alguien se mete detrás del mostrador después del horario"
EJEMPLO de regla mala: "Los empleados deben usar uniforme" (no es observable en imagen)

IMPORTANTE: NUNCA propongas más de 1 regla por mensaje. NUNCA saltes a confirm sin 3 reglas.""",

    "confirm": """ESTÁS EN FASE CONFIRMACIÓN. Tienes 3 reglas confirmadas.
Muestra el resumen EXACTO así:

"{first}, esto es lo que quedó configurado:
📷 Cámara: Cámara {zone}
📍 Zona: {zone}
🕐 Horario: {schedule_open} a {schedule_close}
🌙 Fuera de horario: alerta inmediata si detecto personas

Reglas:
1. {regla_1}
2. {regla_2}
3. {regla_3}

¿Apruebas esta configuración?"

Si dice sí/apruebo/perfecto: genera el bloque [CAMERA_CONFIG] con los datos REALES.
Si dice que no quiere algo, vuelve a rules ajustando lo que pida.""",

}


# ── Endpoint principal Eva v8 ───────────────────────────────────────────

@app.post("/config/chat")
async def config_chat(request: dict):
    user_id = request.get("user_id", "")
    message = request.get("message", "hola")
    session_id = request.get("session_id", "")
    cam_id = request.get("cam_id")
    include_frame = request.get("include_frame", False)

    now = time.time()
    sess = eva_sessions_v8.get(user_id)

    # Reset si sesión expirada o saludo nuevo
    if not sess or message == "__greet__" or (now - sess.get("last_activity", 0) > 600):
        ud = _load_user_v8(user_id)
        owner = ud.get("name", "amigo")
        sess = {
            "phase": "greet",
            "owner": owner,
            "biz": ud.get("business_name", "tu negocio"),
            "biz_type": ud.get("business_type", "negocio"),
            "schedule": ud.get("schedule", {"open": "08:00", "close": "22:00"}),
            "zone": "",
            "rules": [],
            "camera_id": cam_id or "",
            "image_b64": "",
            "image_desc": "",
            "msgs": [],
            "last_activity": now,
            "session_id": session_id,
        }
        eva_sessions_v8[user_id] = sess

    sess["last_activity"] = now

    if cam_id and cam_id != sess.get("camera_id"):
        sess["camera_id"] = cam_id

    # ── Auto-avance: greet → hardware después de primera respuesta del usuario ──
    if sess["phase"] == "greet" and message != "__greet__":
        sess["phase"] = "hardware"
        logger.info(f"🔄 Auto-avance: greet → hardware (usuario respondió zona)")

    # Verificar si hay frame disponible (solo auto-avanzar a vision si el usuario dice que ya conectó)
    image_b64_for_response = ""
    if sess["phase"] in ("hardware", "vision") and not sess["image_b64"]:
        # Solo capturar frame si el usuario indicó que ya conectó la cámara
        user_said_connected = any(w in message.lower() for w in ["ya", "listo", "conectad", "encendid", "terminé", "termine", "listo", "perfecto", "ok", "dale", "eso"])
        if sess["phase"] == "vision" or (sess["phase"] == "hardware" and user_said_connected):
            frame = _get_frame_v8()
            if frame:
                b64 = _resize_and_encode_v8(frame, 640)
                sess["image_b64"] = b64
                sess["image_desc"] = await _describe_image_v8(b64)
                if sess["phase"] == "hardware":
                    sess["phase"] = "vision"
                image_b64_for_response = b64
                logger.info(f"📷 Frame capturado para sesión de {user_id}")

    # ── Auto-detectar zona si el usuario la menciona directamente (antes del LLM) ──
    if sess["phase"] == "hardware" and message != "__greet__":
        msg_lower = message.lower().strip()
        zone_prefixes = ["en la ", "en el ", "en ", "la ", "el ", "caja", "mostrador", "entrada", "almacén", "almacen", "bodega", "oficina", "patio", "estacionamiento", "cocina", "sala", "cuarto", "pasillo", "escalera", "baño", "bano"]
        if len(message.strip()) < 40 and any(msg_lower.startswith(p) or msg_lower == p for p in zone_prefixes):
            if not sess.get("zone") or sess["zone"] in ("la zona que dijo", "lo que dijeron", ""):
                sess["zone"] = message.strip()
                logger.info(f"✅ Zona auto-detectada: {sess['zone']}")
    first = sess["owner"].split()[0] if sess.get("owner") else "amigo"
    sched = sess.get("schedule", {"open": "08:00", "close": "22:00"})
    rules_es = sess.get("rules", [])
    phase_instr = PHASE_INSTRUCTIONS_V8.get(sess["phase"], "")
    phase_instr = (phase_instr
        .replace("{first}", first)
        .replace("{biz_type}", sess.get("biz_type", "negocio"))
        .replace("{rules_count}", str(len(rules_es)))
        .replace("{zone}", sess.get("zone", "no definida"))
        .replace("{schedule_open}", sched.get("open", "08:00"))
        .replace("{schedule_close}", sched.get("close", "22:00"))
        .replace("{regla_1}", rules_es[0] if len(rules_es) > 0 else "(pendiente)")
        .replace("{regla_2}", rules_es[1] if len(rules_es) > 1 else "(pendiente)")
        .replace("{regla_3}", rules_es[2] if len(rules_es) > 2 else "(pendiente)")
    )
    sys = _system_prompt_v8(sess, phase_instr)

    history = sess["msgs"][-8:]
    messages = [{"role": "system", "content": sys}]
    messages.extend(history)

    if message != "__greet__":
        # Incluir imagen solo si el frontend lo pide Y hay imagen, redimensionada a 320px para no saturar al LLM
        if include_frame and sess.get("image_b64"):
            try:
                from gateway_resize import resize_image as _resize
                import base64 as _b64
                img_bytes = _b64.b64decode(sess["image_b64"])
                resized = _resize(img_bytes, max_size=320)
                img_b64_small = _b64.b64encode(resized).decode()
            except Exception:
                img_b64_small = sess["image_b64"]
            user_content = [
                {"type": "image_url", "image_url": {"url": f"data:image/jpeg;base64,{img_b64_small}"}},
                {"type": "text", "text": message},
            ]
        else:
            user_content = message
        messages.append({"role": "user", "content": user_content})
        sess["msgs"].append({"role": "user", "content": message})

    # Llamar al LLM
    raw_response = await _call_qwen_v8(messages, max_tokens=300)

    # Si el LLM no generó señal y estamos en fase que la necesita, reintentar con instrucción más directa
    if not _extract_signal_v8(raw_response) and sess["phase"] in ("greet", "hardware", "vision", "rules", "confirm"):
        logger.info(f"🔁 Reintento: LLM no generó señal en fase {sess['phase']}")
        retry_msg = {
            "role": "user",
            "content": f"IMPORTANTE: En tu respuesta DEBES incluir el bloque [SIGNAL] correspondiente. Sin señal el sistema no puede avanzar. Genera tu respuesta + la señal ahora."
        }
        retry_messages = messages + [retry_msg]
        raw_response = await _call_qwen_v8(retry_messages, max_tokens=200)
        if not _extract_signal_v8(raw_response):
            logger.warning(f"⚠️ LLM no generó señal ni en reintento para fase {sess['phase']}")

    # Procesar señales
    signal = _extract_signal_v8(raw_response)
    camera_config = _extract_camera_config_v8(raw_response)
    clean = _clean_response_v8(raw_response)

    # ── Fallback: si el LLM no generó señal pero el contexto indica avance ──
    if not signal:
        lower_resp = raw_response.lower()
        current = sess["phase"]
        has_img = bool(sess.get("image_b64"))
        # Vision → Rules: LLM menciona "regla" o "preocupación de seguridad"
        if current == "vision" and has_img:
            if any(w in lower_resp for w in ["regla", "proponerte", "te propongo", "reglas de seguridad", "pasar a reglas", "vamos a las reglas", "configurar reglas"]):
                signal = {"phase": "rules"}
                logger.info(f"🔄 Fallback: detectado vision→rules por texto del LLM")
        # Rules → Confirm: LLM muestra resumen con las 3 reglas
        elif current == "rules" and len(sess.get("rules", [])) >= 3:
            if any(w in lower_resp for w in ["resumen", "configuración", "aprob", "¿apruebas", "quedó configurado"]):
                signal = {"phase": "confirm"}
                logger.info(f"🔄 Fallback: detectado rules→confirm por texto del LLM")

    # ── Fallback: en rules, usuario confirma regla propuesta sin signal ──
    if not signal and sess["phase"] == "rules" and message != "__greet__":
        lower_msg = message.lower().strip()
        confirm_words = ["si", "sí", "ok", "perfecto", "dale", "exacto", "correcto", "bueno", "bien", "aprobado"]
        if lower_msg in confirm_words:
            import re as _re2
            rule_match = _re2.search(r'te propongo esta regla[：:]\s*(.+?)(?:\.|$)', raw_response, _re2.IGNORECASE)
            if rule_match:
                rule_text = rule_match.group(1).strip().rstrip('?').strip()
                if rule_text and len(rule_text) > 5:
                    signal = {"phase": "rules", "rule": rule_text}
                    logger.info(f"🔄 Fallback: regla extraída del texto: {rule_text}")

    camera_saved = False

    if signal:
        new_phase = signal.get("phase", sess["phase"])
        zone = signal.get("zone")
        rule = signal.get("rule")

        # ── Guardar zona ──
        if zone and zone.strip():
            zone_clean = zone.strip()
            generic = ["lo que dijeron", "lo que dijo", "la zona", "zona_placeholder"]
            if zone_clean.lower() not in generic:
                sess["zone"] = zone_clean
                logger.info(f"✅ Zona guardada: {sess['zone']}")

        # ── Guardar zona ──
        if zone and zone.strip():
            zone_clean = zone.strip()
            generic = ["lo que dijeron", "lo que dijo", "la zona", "zona_placeholder"]
            if zone_clean.lower() in generic:
                pass  # ignorar zona genérica del LLM
            else:
                sess["zone"] = zone_clean
                logger.info(f"✅ Zona guardada: {sess['zone']}")
            sess["phase"] = "hardware"
            logger.info(f"🔄 Fase: greet → hardware")

        # Hardware → Vision: solo cuando hay frame O el LLM dice que ya conectó
        elif current == "hardware" and new_phase == "vision":
            sess["phase"] = "vision"
            logger.info(f"🔄 Fase: hardware → vision")

        # Hardware → Hardware: el usuario respondió algo que no es "ya conectó"
        elif current == "hardware" and new_phase == "hardware":
            if zone and zone.strip():
                sess["zone"] = zone.strip()
                logger.info(f"✅ Zona actualizada: {sess['zone']}")
            # NO cambiar de fase — seguir en hardware
            logger.info(f"🔄 Mantenido en hardware (zona actualizada)")

        # Vision → Rules: solo si imagen confirmada por el usuario
        elif current == "vision" and new_phase == "rules":
            if not has_image:
                logger.warning(f"⚠️ Intento vision→rules SIN imagen — forzando stay en vision")
                # No avanzar — el backend fuerza quedarse en vision
            else:
                sess["phase"] = "rules"
                logger.info(f"🔄 Fase: vision → rules")

        # Vision: guardar zona si la mencionan
        elif current == "vision":
            if zone and zone.strip():
                sess["zone"] = zone.strip()
                logger.info(f"✅ Zona guardada: {sess['zone']}")

        # Rules → Rules: guardar regla confirmada
        elif current == "rules" and new_phase == "rules":
            if rule and rule.strip() and len(sess["rules"]) < 3 and rule not in sess["rules"]:
                sess["rules"].append(rule.strip())
                logger.info(f"✅ Regla guardada ({len(sess['rules'])}/3): {rule}")
            # No cambiar de fase — seguir en rules hasta que LLM diga "confirm"

        # Rules → Confirm: solo cuando LLM genera resumen con las 3 reglas
        elif current == "rules" and new_phase == "confirm":
            if len(sess["rules"]) >= 3:
                sess["phase"] = "confirm"
                logger.info(f"🔄 Fase: rules → confirm")
            else:
                logger.warning(f"⚠️ rules→confirm con solo {len(sess['rules'])}/3 reglas — forzando stay en rules")

        # Confirm: no cambiar de fase aquí — esperar [CAMERA_CONFIG]
        elif current == "confirm":
            pass

        else:
            # Transición no reconocida — log y no cambiar
            logger.warning(f"⚠️ Transición no válida: {current} → {new_phase} — ignorando")

    # ── Procesar [CAMERA_CONFIG] ──
    if camera_config:
        if len(sess.get("rules", [])) < 3:
            logger.warning(f"⚠️ [CAMERA_CONFIG] con solo {len(sess.get('rules', []))}/3 reglas — ignorando")
        else:
            if sess.get("camera_id") and sess["camera_id"] != "PENDING":
                camera_config["camera_id"] = sess["camera_id"]
            camera_config["_rules_es"] = sess.get("rules", [])
            camera_config["zone"] = sess.get("zone", camera_config.get("zone", ""))
            _save_camera_config_v8(user_id, camera_config)
            camera_saved = True
            sess["phase"] = "done"
            logger.info(f"🎉 Cámara configurada: {camera_config.get('camera_id')} para {user_id}")

    sess["msgs"].append({"role": "assistant", "content": clean})
    eva_sessions_v8[user_id] = sess

    image_url = ""
    if not image_b64_for_response and sess["phase"] == "vision" and sess.get("image_b64"):
        image_b64_for_response = sess["image_b64"]
    if image_b64_for_response:
        image_url = f"data:image/jpeg;base64,{image_b64_for_response}"

    return {
        "success": True,
        "response": clean,
        "image_url": image_url,
        "camera_image_b64": image_b64_for_response if image_b64_for_response else None,
        "ready_to_confirm": len(sess.get("rules", [])) >= 3 and sess["phase"] in ("rules", "confirm"),
        "camera_saved": camera_saved,
        "phase": sess["phase"],
        "rules_count": len(sess.get("rules", [])),
        "rules": sess.get("rules", []),
        "zone": sess.get("zone", ""),
    }
# ── Config Confirm (fallback) ──
@app.post("/config/confirm")
async def config_confirm(request: dict):
    user_id = request.get("user_id", "")
    sess = eva_sessions_v8.get(user_id, {})
    if sess.get("phase") == "done":
        return {"success": True, "message": "Cámara ya configurada"}
    if user_id in eva_sessions:
        session = eva_sessions[user_id]
        session["configured"] = True
        session["phase"] = "completado"
        eva_sessions[user_id] = session
    return {"success": True}

# ── Estado de Camara para Eva ──
@app.get("/config/camera_status")
async def config_camera_status(user_id: str):
    session = eva_sessions_v8.get(user_id, {})
    if not session:
        session = eva_sessions.get(user_id, {})
    frame_bytes = orchestrator.grid.get_last_frame_bytes()
    image_b64 = ""
    if frame_bytes:
        try:
            resized = resize_image(frame_bytes, max_size=512)
            image_b64 = base64.b64encode(resized).decode()
        except:
            image_b64 = base64.b64encode(frame_bytes).decode()
    return {
        "camera_connected": session.get("camera_connected", False),
        "camera_id": session.get("camera_id", ""),
        "has_frame": bool(frame_bytes),
        "image_b64": image_b64,
        "zone": session.get("zone", ""),
        "rules_count": len(session.get("rules", [])),
        "configured": session.get("configured", False),
        "phase": session.get("phase", "unknown"),
        "rules": session.get("rules", []),
    }

