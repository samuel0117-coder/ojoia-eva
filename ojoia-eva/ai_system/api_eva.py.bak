@app.get("/admin/disks/autodetect")
async def admin_disks_autodetect():
    """Detecta montajes activos en el sistema"""
    detected = []
    common_mounts = ["/mnt", "/media", "/home"]  # ampliar según necesidad
    for base in common_mounts:
        if os.path.exists(base):
            try:
                candidates = os.listdir(base)
            except PermissionError:
                continue
            for c in candidates:
                mp = os.path.join(base, c)
                if os.path.ismount(mp):
                    detected.append({"mount": mp, "label": os.path.basename(mp)})
    return {"detected": detected}


@app.post("/admin/disks/scan")
async def admin_disks_scan():
    """Escanea discos y actualiza used/free GB en la config"""
    cfg = get_disk_config()
    for disk in cfg.get("disks", []):
        mount = disk.get("mount", "")
        if mount and os.path.exists(mount):
            try:
                st = os.statvfs(mount)
                total = st.f_blocks * st.f_frsize
                free  = st.f_bavail * st.f_frsize
                disk["total_gb"] = round(total / (1024**3), 1)
                disk["free_gb"]  = round(free  / (1024**3), 1)
                disk["used_gb"]  = round((total - free) / (1024**3), 1)
            except OSError:
                pass
    save_disk_config(cfg)
    return {"success": True, "disks": cfg.get("disks", [])}


@app.post("/admin/disks/save")
async def admin_disks_save(request: dict):
    """Guarda la configuración completa de discos y planes"""
    required = ["disks", "plans"]
    if not all(k in request for k in required):
        raise HTTPException(status_code=400, detail="Missing fields")
    save_disk_config(request)
    return {"success": True}


@app.post("/admin/disks/add")
async def admin_disks_add(request: dict):
    """Agrega un nuevo disco a la configuración"""
    cfg = get_disk_config()
    mount = request.get("mount", "")
    if not mount or mount in [d.get("mount") for d in cfg["disks"]]:
        raise HTTPException(status_code=400, detail="Mount path empty or already exists")
    cfg["disks"].append({
        "mount": mount,
        "label": request.get("label", mount),
        "total_gb": 0, "used_gb": 0, "free_gb": 0,
        "user_folder": request.get("user_folder", "users")
    })
    save_disk_config(cfg)
    return {"success": True}


@app.post("/admin/disks/remove")
async def admin_disks_remove(request: dict):
    """Elimina un disco de la configuración"""
    cfg = get_disk_config()
    mount = request.get("mount", "")
    cfg["disks"] = [d for d in cfg["disks"] if d.get("mount") != mount]
    save_disk_config(cfg)
    return {"success": True}

@app.get("/admin/storage/{user_id}")
async def admin_get_user_storage(user_id: str):
    """Devuelve info de almacenamiento del usuario, resolviendo la ruta desde la config de discos"""
    cfg = get_disk_config()
    plan = "free"
    disk_mount = STORAGE_ROOT
    user_file_compat = f"{STORAGE_ROOT}/users/{user_id}/user.json"

    # Leer plano desde compat o desde disk config
    if os.path.exists(user_file_compat):
        with open(user_file_compat) as f:
            ud = json.load(f)
        plan = ud.get("plan", "free")

    # Resolver ruta real desde config de discos
    storage_path = get_user_storage_path(user_id, plan)
    disk_mount = os.path.dirname(storage_path)

    # Calcular uso desde la ruta real
    used_mb = 0
    user_dir = storage_path
    if os.path.isdir(user_dir):
        for root, dirs, files in os.walk(user_dir):
            for fi in files:
                fp = os.path.join(root, fi)
                if os.path.isfile(fp):
                    used_mb += os.path.getsize(fp)
    used_mb = round(used_mb / (1024**2), 1)

    plan_data = cfg.get("plans", {}).get(plan, {})
    return {
        "user_id": user_id,
        "disk_mount": disk_mount,
        "quota_gb": plan_data.get("max_storage_gb", 500),
        "used_mb": used_mb,
        "usage_percent": round(used_mb / (plan_data.get("max_storage_gb", 500) * 1024) * 100, 1) if plan_data.get("max_storage_gb") else 0,
        "plan": plan
    }

@app.post("/admin/storage/{user_id}/update")
async def admin_update_user_storage(user_id: str, request: dict):
    """Actualiza plan / quota de un usuario"""
    user_file = _find_user_json(user_id)
    if not user_file:
        raise HTTPException(status_code=404, detail="Usuario no encontrado")
    with open(user_file) as f:
        user_data = json.load(f)
    if "plan" in request:
        user_data["plan"] = request["plan"]
    if "quota_gb" in request:
        user_data["quota_gb"] = request["quota_gb"]
    with open(user_file, "w") as f:
        json.dump(user_data, f, indent=2)
    return {"success": True}

@app.post("/admin/storage/{user_id}/migrate")
async def admin_migrate_user(user_id: str, request: dict):
    """Migra un usuario a un nuevo disco creando user.json en la nueva ruta y reemplazando el disk_mount"""
    new_disk_mount = request.get("disk_mount", STORAGE_ROOT)
    cfg = get_disk_config()

    # Encontrar disco destino en config
    target_disk = None
    for d in cfg.get("disks", []):
        if d.get("mount") == new_disk_mount:
            target_disk = d
            break
    if not target_disk:
        target_disk = {"mount": new_disk_mount, "user_folder": "users"}
    user_folder = target_disk.get("user_folder", "users")
    new_user_dir = f"{new_disk_mount}/{user_folder.strip('/')}/{user_id}"
    new_user_file = f"{new_user_dir}/user.json"

    # Leer datos existentes del usuario desde cualquier disco
    existing = {}
    old_file = _find_user_json(user_id)
    if old_file:
        with open(old_file) as f:
            existing = json.load(f)

    existing["disk_mount"] = new_disk_mount
    os.makedirs(new_user_dir, exist_ok=True)
    with open(new_user_file, "w") as f:
        json.dump(existing, f, indent=2)

    # Actualizar compat en STORAGE_ROOT si difiere
    compat_file = f"{STORAGE_ROOT}/users/{user_id}/user.json"
    if compat_file != new_user_file:
        os.makedirs(os.path.dirname(compat_file), exist_ok=True)
        with open(compat_file, "w") as f:
            json.dump(existing, f, indent=2)

    return {"success": True, "new_path": new_user_dir}

