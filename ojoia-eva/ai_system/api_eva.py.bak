@app.get("/admin/stats")
async def admin_stats():
    cfg = get_disk_config()
    events_count = 0
    violations_count = 0

    # Contar eventos desde todos los discos configurados
    for disk in cfg.get("disks", []):
        users_base = os.path.join(disk.get("mount", ""), disk.get("user_folder", "users"))
        if not os.path.isdir(users_base):
            continue
        for uid in os.listdir(users_base):
            for _cam_id, events_dir in _resolve_user_events_dirs(uid):
                if os.path.exists(events_dir):
                    for f in os.listdir(events_dir):
                        if f.endswith('.json'):
                            events_count += 1
                            with open(f"{events_dir}/{f}") as fh:
                                ev = json.load(fh)
                                if ev.get("event_type") == "violation":
                                    violations_count += 1

    # Calcular total de cámaras
    total_cameras = 0
    cfg = get_disk_config()
    user_cameras = set()
    for disk in cfg.get("disks", []):
        users_base = os.path.join(disk.get("mount", ""), disk.get("user_folder", "users"))
        if not os.path.isdir(users_base):
            continue
        for uid in os.listdir(users_base):
            user_file = os.path.join(users_base, uid, "user.json")
            if os.path.isfile(user_file):
                try:
                    with open(user_file) as f:
                        udata = json.load(f)
                    for cam in udata.get("cameras", []):
                        user_cameras.add(cam.get("camera_id", ""))
                except Exception:
                    pass
    total_cameras = len(user_cameras)

    # Leer used_gb de la config de discos
    storage_used_gb = 0
    for disk in cfg.get("disks", []):
        total_gb = disk.get("total_gb", 0) or 0
        used_gb  = disk.get("used_gb",  0) or 0
        storage_used_gb += used_gb

    total_users = 0
    for disk in cfg.get("disks", []):
        users_base = os.path.join(disk.get("mount", ""), disk.get("user_folder", "users"))
        if os.path.isdir(users_base):
            total_users += len(os.listdir(users_base))

    return {
        "total_users": total_users,
        "total_cameras": total_cameras,
        "active_cameras": len(orchestrator.grid.get_grid_info()["camera_ids"]),
        "storage_used_gb": round(storage_used_gb, 2),
        "total_events": events_count,
        "total_violations": violations_count,
        "memory_used_percent": 0,
        "uptime_hours": 0
    }

@app.get("/admin/disks")
async def admin_disks():
    """Devuelve la configuración de discos desde disco (persistente)"""
    return get_disk_config()

@app.get("/admin/users")
async def admin_users():
    users = []
    cfg = get_disk_config()
    seen = set()
    # Escanear todos los discos configurados
    for disk in cfg.get("disks", []):
        users_base = os.path.join(disk.get("mount", ""), disk.get("user_folder", "users"))
        if not os.path.isdir(users_base):
            continue
        for uid in os.listdir(users_base):
            if uid in seen:
                continue
            user_file = os.path.join(users_base, uid, "user.json")
            if os.path.isfile(user_file):
                try:
                    with open(user_file) as f:
                        users.append(json.load(f))
                    seen.add(uid)
                except Exception:
                    pass
    return {"users": users}


