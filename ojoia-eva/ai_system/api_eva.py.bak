@app.post("/fcm/test")
async def api_fcm_test(request: dict):
    """Enviar notificación de prueba."""
    user_id = request.get("user_id", "default")
    title = request.get("title", "🚨 Prueba - OjoIA")
    body = request.get("body", "Notificación de prueba")
    from orchestrator import send_fcm_notification
    result = await send_fcm_notification(title=title, body=body, user_id=user_id)
    return {"success": result, "message": "Notificación enviada" if result else "No hay tokens válidos"}


@app.get("/api/user/events/stats")
async def get_user_events_stats(user_id: str, date: str = None):
    """Conteo rápido de eventos del usuario."""
    now = int(time.time())
    start_of_today = now - (now % 86400)
    total = 0
    today_count = 0
    alerts_count = 0
    for cam_id, events_dir in _resolve_user_events_dirs(user_id):
        if not os.path.exists(events_dir):
            continue
        for fname in sorted(os.listdir(events_dir), reverse=True):
            if not fname.endswith('.json'):
                continue
            try:
                with open(f"{events_dir}/{fname}") as f:
                    ev = json.load(f)
            except:
                continue
            total += 1
            ts = ev.get("timestamp", 0)
            if ts >= start_of_today:
                today_count += 1
            if ev.get("event_type") == "violation":
                alerts_count += 1
    return {"total": total, "today": today_count, "alerts": alerts_count}


@app.get("/api/user/latest_analysis")
async def get_latest_analysis(user_id: str):
    """Último análisis Qwen."""
    latest = None
    for cam_id, events_dir in _resolve_user_events_dirs(user_id):
        if not os.path.exists(events_dir):
            continue
        for fname in sorted(os.listdir(events_dir), reverse=True):
            if not fname.endswith('.json'):
                continue
            try:
                with open(f"{events_dir}/{fname}") as f:
                    ev = json.load(f)
            except:
                continue
            ts = ev.get("timestamp", 0)
            if latest is None or ts > latest["timestamp"]:
                latest = {
                    "event_id": ev.get("event_id", ""),
                    "event_type": ev.get("event_type", ""),
                    "timestamp": ts,
                    "qwen_violation": ev.get("event_type") == "violation",
                    "qwen_description": ev.get("metadata", {}).get("qwen_analysis", ""),
                    "camera_id": ev.get("camera_id", ""),
                }
    if latest is None:
        return {"found": False, "violation": False, "description": "", "timestamp": 0}
    latest["found"] = True
    return latest


@app.get("/api/cameras/{camera_id}/grid")
async def api_get_camera_grid(camera_id: str):
    """Último frame individual de una cámara específica."""
    last_cam_id = orchestrator.grid.get_last_camera_id()
    frame_bytes = orchestrator.grid.get_last_frame_bytes() if last_cam_id == camera_id else b''
    image_b64 = base64.b64encode(frame_bytes).decode("utf-8") if frame_bytes else ""
    return {
        "success": True, "camera_id": camera_id, "image_b64": image_b64,
        "yolo": {"count": 0}, "qwen": {"violation": False}
    }


@app.post("/device/announce")
async def device_announce(request: dict):
    """Endpoint que recibe cuando una cámara nueva se conecta."""
    camera_id = request.get("camera_id", "")
    user_id = request.get("user_id", "")
    if not camera_id:
        raise HTTPException(status_code=400, detail="camera_id requerido")
    image_b64 = ""
    frame_bytes = orchestrator.grid.get_last_frame_bytes()
    last_cam_id = orchestrator.grid.get_last_camera_id()
    if frame_bytes and (last_cam_id == camera_id or not user_id):
        import base64 as _b64
        from gateway_resize import resize_image
        try:
            resized = resize_image(frame_bytes, max_size=256)
            image_b64 = _b64.b64encode(resized).decode("utf-8")
        except:
            image_b64 = _b64.b64encode(frame_bytes).decode("utf-8")
    if user_id and user_id in eva_sessions:
        s = eva_sessions[user_id]
        s["camera_id"] = camera_id
        s["camera_image_b64"] = image_b64
        s["camera_connected"] = True
        eva_sessions[user_id] = s
    return {
        "success": True, "message": f"Camera {camera_id} connected",
        "camera_id": camera_id, "image_b64": image_b64,
        "frame_available": bool(frame_bytes)
    }


@app.get("/config/camera_status")
async def config_camera_status(user_id: str):
    """Consulta si hay cámara conectada e imagen disponible para la sesión de Eva."""
    s = eva_sessions.get(user_id, {})
    frame_bytes = orchestrator.grid.get_last_frame_bytes()
    image_b64 = ""
    if frame_bytes:
        from gateway_resize import resize_image
        try:
            resized = resize_image(frame_bytes, max_size=512)
            image_b64 = base64.b64encode(resized).decode("utf-8")
        except:
            image_b64 = base64.b64encode(frame_bytes).decode("utf-8")
    return {
        "camera_connected": s.get("camera_connected", False),
        "camera_id": s.get("camera_id", ""),
        "has_frame": bool(frame_bytes),
        "image_b64": image_b64,
        "zone": s.get("zone", ""),
        "rules_count": len(s.get("rules", [])),
        "configured": s.get("configured", False)
    }


@app.get("/admin/cameras")
async def admin_cameras():
    """Lista todas las cámaras del sistema."""
    cfg = get_disk_config()
    now = time.time()
    cameras = []
    active_ids = set(orchestrator.grid.get_grid_info()["camera_ids"])
    last_seen = {}
    for f in orchestrator.grid.frames:
        lid = f.get("camera_id", "")
        ts = f.get("timestamp", 0)
        if lid and (lid not in last_seen or ts > last_seen[lid]):
            last_seen[lid] = ts
    for disk in cfg.get("disks", []):
        users_base = os.path.join(disk.get("mount", ""), disk.get("user_folder", "users"))
        if not os.path.isdir(users_base):
            continue
        for uid in os.listdir(users_base):
            user_file = os.path.join(users_base, uid, "user.json")
            if not os.path.isfile(user_file):
                continue
            try:
                with open(user_file) as fh:
                    udata = json.load(fh)
            except:
                continue
            for cam in udata.get("cameras", []):
                cid = cam.get("camera_id", "")
                ts = last_seen.get(cid, 0)
                online = (now - ts) < 300
                cameras.append({
                    "camera_id": cid, "name": cam.get("name", cid),
                    "zone": cam.get("zone", ""), "user_id": uid,
                    "business_name": udata.get("business_name", ""),
                    "status": "online" if online else "offline",
                    "active": cam.get("active", True),
                    "last_seen_seconds_ago": int(now - ts) if ts else None,
                    "last_seen": datetime.fromtimestamp(ts).isoformat() if ts else None,
                })
    return {"cameras": cameras}


@app.get("/admin/events")
async def admin_events(limit: int = 50, user_id: str = None, event_type: str = None):
    """Lista eventos recientes con filtros."""
    cfg = get_disk_config()
    events = []
    for disk in cfg.get("disks", []):
        users_base = os.path.join(disk.get("mount", ""), disk.get("user_folder", "users"))
        if not os.path.isdir(users_base):
            continue
        for uid in os.listdir(users_base):
            if user_id and uid != user_id:
                continue
            for _cam_id, events_dir in _resolve_user_events_dirs(uid):
                if not os.path.exists(events_dir):
                    continue
                for fname in sorted(os.listdir(events_dir), reverse=True):
                    if not fname.endswith(".json"):
                        continue
                    ef = f"{events_dir}/{fname}"
                    try:
                        with open(ef) as fh:
                            ev = json.load(fh)
                    except:
                        continue
                    if event_type and ev.get("event_type") != event_type:
                        continue
                    ev["_user_id"] = uid
                    events.append(ev)
                    if len(events) >= limit:
                        break
    events.sort(key=lambda e: e.get("timestamp", 0), reverse=True)
    return {"events": events[:limit], "total": len(events)}


@app.get("/admin/events/stats")
async def admin_events_stats(days: int = 7):
    """Estadísticas de eventos."""
    from collections import Counter, defaultdict
    cfg = get_disk_config()
    now = time.time()
    cutoff = now - days * 86400
    per_day = defaultdict(int)
    per_type = Counter()
    top_rules = Counter()
    total = 0
    for disk in cfg.get("disks", []):
        users_base = os.path.join(disk.get("mount", ""), disk.get("user_folder", "users"))
        if not os.path.isdir(users_base):
            continue
        for uid in os.listdir(users_base):
            for _cam_id, events_dir in _resolve_user_events_dirs(uid):
                if not os.path.exists(events_dir):
                    continue
                for fname in os.listdir(events_dir):
                    if not fname.endswith(".json"):
                        continue
                    ef = f"{events_dir}/{fname}"
                    try:
                        with open(ef) as fh:
                            ev = json.load(fh)
                    except:
                        continue
                    ts = ev.get("timestamp", 0)
                    if ts < cutoff:
                        continue
                    day = datetime.utcfromtimestamp(ts).strftime("%Y-%m-%d")
                    per_day[day] += 1
                    etype = ev.get("event_type", "unknown")
                    per_type[etype] += 1
                    if etype == "violation":
                        rules = ev.get("metadata", {}).get("violated_rules", [])
                        for r in rules:
                            top_rules[r] += 1
                    total += 1
    daily = [{"date": d, "count": c} for d, c in sorted(per_day.items())]
    return {"days": days, "total_events": total, "by_day": daily, "by_type": dict(per_type), "top_rules": top_rules.most_common(10)}


@app.post("/admin/firebase/update-server-status")
async def update_server_status(request: dict):
    """Update Firestore server_status."""
    try:
        db = firebase_admin.firestore.client()
        url = request.get("backend", "https://api.ojoia.com.do")
        db.collection('system').doc('server_status').set({
            "backend": url, "ngrok_url": url, "updated_at": int(time.time())
        }, merge=True)
        return {"success": True, "backend": url}
    except Exception as e:
        return {"success": False, "error": str(e)}


@app.post("/config/chat")
async def config_chat(request: dict):
    user_id = request.get("user_id", "")
    message = request.get("message", "hola")

    if message == "__greet__":
        eva_sessions.pop(user_id, None)

    s = eva_sessions.get(user_id, {
        "msgs": [], "zone": "", "rules": [], "camera_id": "",
        "camera_connected": False, "camera_image_b64": "",
        "image_shown": False, "phase": "saludo",
        "concerns": [], "schedule": {"open": "08:00", "close": "22:00"}
    })

    user_file = _find_user_json(user_id)
    owner = "amigo"
    biz = "tu negocio"
    biz_type = "negocio"
    schedule = {"open": "08:00", "close": "22:00"}
    existing_cams = []
    if user_file:
        try:
            with open(user_file) as f:
                u = json.load(f)
            owner = u.get("owner_name") or u.get("name", "amigo")
            biz = u.get("business_name") or u.get("business_type", "tu negocio")
            biz_type = u.get("business_type", "negocio")
            schedule = u.get("schedule", schedule)
            existing_cams = u.get("cameras", [])
        except:
            pass

    frame_bytes = orchestrator.grid.get_last_frame_bytes()
    has_frame = bool(frame_bytes)
    frame_b64 = ""
    if has_frame:
        try:
            resized = resize_image(frame_bytes, max_size=512)
            frame_b64 = base64.b64encode(resized).decode("utf-8")
        except:
            frame_b64 = base64.b64encode(frame_bytes).decode("utf-8")

    if has_frame and not s.get("camera_image_b64"):
        s["camera_image_b64"] = frame_b64
        s["camera_connected"] = True

    first_name = owner.split()[0]
    current_phase = s.get("phase", "saludo")
    rules_so_far = s.get("rules", [])
    concerns_so_far = s.get("concerns", [])
    rules_count = len(rules_so_far)
    zone = s.get("zone", "")
    image_description = s.get("image_description", "")
    business_info = " ".join(s.get("business_info", []))

    def _build_system(phase_instruction: str, extra: str = "") -> str:
        return f"""Eres Eva, asistente de seguridad de OjoIA.

CONTEXTO DEL NEGOCIO:
- Dueño: {owner}
- Negocio: {biz} ({biz_type})
- Horario: {schedule.get('open', '08:00')} a {schedule.get('close', '22:00')}
- Zona de la cámara: {zone if zone else 'no definida'}

ESTADO DE LA CONFIGURACIÓN:
- Fase actual: {current_phase}
- Preocupaciones del usuario: {concerns_so_far if concerns_so_far else 'aún no mencionadas'}
- Reglas confirmadas: {rules_count}/3 — {rules_so_far if rules_so_far else 'ninguna'}
- Info del negocio: {business_info if business_info else 'aún no proporcionada'}
- Descripción de imagen: {image_description if image_description else 'sin imagen aún'}

INSTRUCCIÓN ACTUAL:
{phase_instruction}
{extra}

REGLAS PARA EVA:
- Tono dominicano, cercano, directo. Máximo 3-4 líneas por respuesta.
- NO uses términos técnicos (YOLO, grid, scanner, tokens, API).
- Responde de forma natural según el contexto y el mensaje del usuario.
- Cuando propongas una regla, di exactamente: 'Te propongo esta regla: [regla específica]. ¿Te parece bien o quieres que la ajuste?'
- NO guardes ninguna regla hasta que el usuario acepte explícitamente.
- Solo cuando acepte, di: '✅ Regla X guardada: [descripción breve]'
- Máximo 3 reglas.
- El usuario NUNCA debe ver bloques técnicos como [CAMERA_CONFIG]."""

    def _build_messages(sys_prompt: str) -> list:
        msgs = [{"role": "system", "content": sys_prompt}]
        for m in s.get("msgs", [])[-10:]:
            role = m.get("role", "user")
            content = m.get("content", "")
            if role == "assistant" and "[CAMERA_CONFIG]" in content:
                continue
            if isinstance(content, list):
                has_img = any(isinstance(c, dict) and c.get("type") == "image_url" for c in content)
                if has_img:
                    text_parts = [c.get("text", "") for c in content if isinstance(c, dict) and c.get("type") == "text"]
                    content = " ".join(text_parts)
                    if not content.strip():
                        continue
            msgs.append({"role": role, "content": content})
        return msgs

    async def _qwen(messages: list, max_tok: int = 300) -> str:
        try:
            async with httpx.AsyncClient(timeout=30) as client:
                resp = await client.post(
                    "http://localhost:8004/v1/chat/completions",
                    json={"model": "qwen", "messages": messages, "max_tokens": max_tok}
                )
                if resp.status_code == 200:
                    return resp.json().get("choices", [{}])[0].get("message", {}).get("content", "")
        except Exception as e:
            logger.error(f"config_chat _qwen error: {e}")
        return "Disculpa, tuve un problema. ¿Puedes repetir?"

    async def _describe_image(img_b64: str) -> str:
        try:
            async with httpx.AsyncClient(timeout=15) as client:
                resp = await client.post(
                    "http://localhost:8004/v1/chat/completions",
                    json={
                        "model": "qwen",
                        "messages": [{
                            "role": "user",
                            "content": [
                                {"type": "image_url", "image_url": {"url": f"data:image/jpeg;base64,{img_b64}"}},
                                {"type": "text", "text": "Describe brevemente esta imagen (máximo 30 palabras). ¿Qué zona es? ¿Hay mostrador, caja, estantes, personas, columna? ¿Ves algún problema como reflejos o ángulo malo?"}
                            ]
                        }],
                        "max_tokens": 100
                    }
                )
                if resp.status_code == 200:
                    return resp.json().get("choices", [{}])[0].get("message", {}).get("content", "")
        except:
            pass
        return "Veo la zona donde instalaste la cámara."

    def _poor_quality(desc: str) -> bool:
        return any(kw in desc.lower() for kw in ["reflejo", "reflejos", "ángulo", "angle", "malo", "bajo", "cortado", "oscuro", "borroso", "no se ve", "difícil", "problem"])

    # ── FASE: SALUDO ──
    if current_phase == "saludo" and not s.get("msgs"):
        s["msgs"] = []
        sys_p = _build_system(
            f"Es el primer contacto con el usuario. Saluda de forma cálida y natural usando su nombre ({owner}). "
            f"Menciona que tienes registrado su {biz_type} ({biz}) y que van a configurar una cámara nueva. "
            f"Pregunta dónde quiere poner la cámara. Sé breve y amigable."
        )
        s["msgs"].append({"role": "user", "content": "Hola"})
        msgs = _build_messages(sys_p)
        answer = await _qwen(msgs)
        s["phase"] = "zona"
        s["msgs"].append({"role": "assistant", "content": answer})
        eva_sessions[user_id] = s
        return {"success": True, "response": answer, "ready_to_confirm": False, "camera_image_b64": "", "zone": "", "rules": []}

    # ── FASE: ZONA (usuario dice dónde poner la cámara) ──
    if current_phase == "zona":
        s["zone"] = message.strip()
        zone = s["zone"]
        s["phase"] = "hardware"
        s["msgs"].append({"role": "user", "content": message})
        sys_p = _build_system(
            f"PASO ACTUAL: El usuario dijo que quiere la cámara en '{zone}'.\n"
            f"ACCIÓN: Confirma la zona. Luego INSTRUYE al usuario para que ÉL encienda físicamente la cámara.\n"
            f"IMPORTANTE: Tú NO puedes encender la cámara. EL USUARIO debe hacerlo.\n"
            f"Di algo como: 'Perfecto. Ahora ENCIENDE la cámara (tú físico). La luz va a parpadear azul. Avímanos cuando lo veas.'\n"
            f"NO digas '¿Quieres que encienda?' ni 'Voy a encender'. El usuario es quien enciende."
        )
        msgs = _build_messages(sys_p)
        answer = await _qwen(msgs)
        s["msgs"].append({"role": "assistant", "content": answer})
        eva_sessions[user_id] = s
        return {"success": True, "response": answer, "ready_to_confirm": False, "camera_image_b64": "", "zone": zone, "rules": []}

    # ── FASE: HARDWARE (enciende la cámara) ──
    if current_phase == "hardware":
        lower = message.lower()
        hw_keywords = ["ya", "listo", "enciend", "prendí", "prendida", "azul", "parpade", "la veo", "ya la veo", "luz azul", "parpadeando", "luz", "led", "ya está", "esta", "lo veo"]
        if any(w in lower for w in hw_keywords):
            s["phase"] = "wifi"
            s["msgs"].append({"role": "user", "content": message})
            answer = await _qwen(_build_messages(_build_system(
                f"El usuario dice: '{message}' (confirmó que ve la cámara encendida).\n"
                f"Responde confirmando y dándole instrucciones para conectarse al WiFi.\n"
                f"Menciona la red 'OjoIA-XXXX' y pídele que te avise cuando esté conectado.\n"
                f"Ejemplo: '¡Excelente! Ahora ve al WiFi de tu celular...'"
            )))
            s["msgs"].append({"role": "assistant", "content": answer})
            eva_sessions[user_id] = s
            return {"success": True, "response": answer, "ready_to_confirm": False, "camera_image_b64": "", "zone": zone, "rules": []}
        else:
            s["msgs"].append({"role": "user", "content": message})
            answer = await _qwen(_build_messages(_build_system(
                f"El usuario dice: '{message}'.\n"
                f"Pídele que ENCIENDA la cámara físicamente (ÉL debe hacerlo).\n"
                f"Dile que la luz va a parpadear azul y que te avise cuando lo vea.\n"
                f"NO digas '¿Quieres que encienda?' El usuario es quien enciende."
            )))
            s["msgs"].append({"role": "assistant", "content": answer})
            eva_sessions[user_id] = s
            return {"success": True, "response": answer, "ready_to_confirm": False, "camera_image_b64": "", "zone": zone, "rules": []}

    # ── FASE: WiFi (conectar al WiFi) ──
    if current_phase == "wifi":
        lower = message.lower()
        if any(w in lower for w in ["ya", "listo", "conect", "ok", "bien", "hecho"]):
            s["phase"] = "esperando_imagen"
            s["camera_connected"] = True
            s["msgs"].append({"role": "user", "content": message})
            answer = await _qwen(_build_messages(_build_system(
                f"El usuario dice: '{message}' (confirmó conexión al WiFi).\n"
                f"Dile que esperes un momento mientras recibes la imagen de la cámara.\n"
                f"Pídele paciencia. Si después de unos segundos no llega, pídele que diga 'revisa'.\n"
                f"NO le hagas preguntas. Solo espera la imagen."
            )))
            s["msgs"].append({"role": "assistant", "content": answer})
            eva_sessions[user_id] = s
            return {"success": True, "response": answer, "ready_to_confirm": False, "camera_image_b64": "", "zone": zone, "rules": []}
        else:
            s["msgs"].append({"role": "user", "content": message})
            answer = await _qwen(_build_messages(_build_system(
                f"El usuario dice: '{message}'.\n"
                f"Pídele que se conecte al WiFi 'OjoIA-XXXX' y luego elija su WiFi del negocio.\n"
                f"Dile que te avise cuando esté conectado."
            )))
            s["msgs"].append({"role": "assistant", "content": answer})
            eva_sessions[user_id] = s
            return {"success": True, "response": answer, "ready_to_confirm": False, "camera_image_b64": "", "zone": zone, "rules": []}

    # ── FASE: ESPERANDO IMAGEN (usuario dice 'revisa' o similar) ──
    if current_phase == "esperando_imagen":
        if has_frame:
            s["camera_image_b64"] = frame_b64
            s["image_shown"] = True
            s["camera_connected"] = True
            image_description = await _describe_image(frame_b64)
            s["image_description"] = image_description
            img_b64 = frame_b64
            is_poor = _poor_quality(image_description)
            if is_poor:
                s["phase"] = "ajustando_camara"
                sys_p = _build_system(
                    f"El usuario pidió revisar la imagen y HAY frame. Tu análisis: {image_description}. "
                    f"La imagen tiene problemas de calidad (reflejos, ángulo malo, zona cortada). "
                    f"Describe al usuario ({first_name}) lo que ves: qué problemas tiene la imagen. "
                    f"Da instrucciones ESPECÍFICAS de ajuste: dónde mover la cámara, qué ángulo usar, qué evitar. "
                    f"Pide que ajuste y avise cuando esté listo."
                )
            else:
                s["phase"] = "mostrando_imagen"
                sys_p = _build_system(
                    f"El usuario pidió revisar la imagen y HAY frame. Tu análisis: {image_description}. "
                    f"La imagen se ve bien. Describe al usuario ({first_name}) lo que ves en detalle. "
                    f"PREGUNTA: 'Según lo que veo, parece que la cámara está apuntando a [zona detectada]. "
                    f"¿Este es el lugar correcto que quieres vigilar?' "
                    f"Deja que el usuario confirme o corrija el lugar. Ustedes dos deben ponerse de acuerdo."
                )
            # Include image in messages so Qwen can see it
            msgs = _build_messages(sys_p)
            if img_b64 and s.get("camera_image_b64"):
                if msgs and len(msgs) > 1:
                    last_msg = msgs[-1]
                    if last_msg.get("role") == "user":
                        last_msg["content"] = [
                            {"type": "image_url", "image_url": {"url": f"data:image/jpeg;base64,{img_b64}"}},
                            {"type": "text", "text": last_msg.get("content", "")}
                        ]
            answer = await _qwen(msgs)
            s["msgs"].append({"role": "assistant", "content": answer})
            eva_sessions[user_id] = s
            return {"success": True, "response": answer, "ready_to_confirm": False, "camera_saved": False, "camera_image_b64": img_b64, "zone": zone, "rules": rules_so_far}
        else:
            sys_p = _build_system(
                f"El usuario dice '{message}' pero aún NO hay imagen de la cámara. "
                f"Dile a {first_name} que la imagen aún no llega. "
                f"Pídele que verifique: cámara encendida, conectada al WiFi, apuntando a la zona. "
                f"Dile que diga 'revisa' de nuevo cuando quiera intentar otra vez. "
                f"NO inventes ajustes ni reglas. Solo espera la imagen."
            )
            msgs = _build_messages(sys_p)
            answer = await _qwen(msgs)
            s["msgs"].append({"role": "assistant", "content": answer})
            eva_sessions[user_id] = s
            return {"success": True, "response": answer, "ready_to_confirm": False, "camera_saved": False, "camera_image_b64": "", "zone": zone, "rules": rules_so_far}

    # ── FASE: ZONA CONFIRMADA (usuario explica cómo funciona) ──
    if current_phase == "zona_confirmada":
        s["phase"] = "proponiendo_regla"
        if "business_info" not in s:
            s["business_info"] = []
        s["business_info"].append(message)
        business_info = " ".join(s["business_info"])
        sys_p = _build_system(
            f"El usuario te explicó cómo funciona su negocio: '{message}'. "
            f"Toda la info del negocio hasta ahora: {business_info}. "
            f"ANALIZA lo que te dijo y la imagen de la cámara ({image_description}). "
            f"Piensa cuál es el mayor riesgo. Luego propón UNA sola regla específica. "
            f"Di: 'Te propongo esta regla: [regla específica]. ¿Te parece bien o quieres que la ajuste?'"
        )
        # Include image in messages so Qwen can see it
        msgs = _build_messages(sys_p)
        # Add image to the last user message if available
        if img_b64 and s.get("camera_image_b64"):
            if msgs and len(msgs) > 1:
                last_msg = msgs[-1]
                if last_msg.get("role") == "user":
                    last_msg["content"] = [
                        {"type": "image_url", "image_url": {"url": f"data:image/jpeg;base64,{img_b64}"}},
                        {"type": "text", "text": last_msg.get("content", "")}
                    ]
        answer = await _qwen(msgs)
        s["msgs"].append({"role": "assistant", "content": answer})
        eva_sessions[user_id] = s
        return {"success": True, "response": answer, "ready_to_confirm": False, "camera_saved": False, "camera_image_b64": "", "zone": zone, "rules": rules_so_far}

    # ── FASE: PROPONIENDO REGLA ──
    if current_phase == "proponiendo_regla":
        lower = message.lower()
        concern_keywords = ["me preocupa", "quiero que", "también", "además", "otra cosa", "y que", "que se", "que no", "que los", "que la", "que el"]
        strong_accept = ["perfecto", "exacto", "correcto", "dale", "vamos", "apruebo", "confirmo", "acepto", "suena bien", "me gusta"]
        is_concern = any(w in lower for w in concern_keywords)
        is_accept = any(w in lower for w in strong_accept)
        is_reject = any(w in lower for w in ["no", "cambia", "modifica", "diferente", "mejor", "prefiero"])

        if is_concern and not is_accept:
            if "concerns" not in s:
                s["concerns"] = []
            s["concerns"].append(message)
            concerns_so_far = s["concerns"]
            s["phase"] = "proponiendo_regla"
            sys_p = _build_system(
                f"El usuario expresó una nueva preocupación: '{message}'. "
                f"Preocupaciones acumuladas: {concerns_so_far}. "
                f"Propón UNA regla específica basada en esta preocupación. "
                f"Di: 'Te propongo esta regla: [regla]. ¿Te parece bien o quieres que la ajuste?'"
            )
            msgs = _build_messages(sys_p)
            answer = await _qwen(msgs)
            s["msgs"].append({"role": "assistant", "content": answer})
            eva_sessions[user_id] = s
            return {"success": True, "response": answer, "ready_to_confirm": False, "camera_saved": False, "camera_image_b64": "", "zone": zone, "rules": rules_so_far}

        elif is_accept and not is_reject:
            if "rules" not in s:
                s["rules"] = []
            rule_num = len(s["rules"]) + 1
            s["rules"].append(f"regla_{rule_num}")
            rules_so_far = s["rules"]
            rules_count = len(rules_so_far)
            if rules_count >= 3:
                s["phase"] = "confirmando"
                sys_p = _build_system(
                    f"✅ Regla {rule_num} guardada. Ya tienen {rules_count}/3 reglas. "
                    f"Ahora pregunta sobre el horario del negocio. "
                    f"Dile que fuera de ese horario vas a estar alerta a cualquier persona. "
                    f"Pregunta: ¿Cuál es el horario de tu {biz_type}?"
                )
                msgs = _build_messages(sys_p)
                answer = await _qwen(msgs)
                s["msgs"].append({"role": "assistant", "content": answer})
                eva_sessions[user_id] = s
                return {"success": True, "response": answer, "ready_to_confirm": False, "camera_saved": False, "camera_image_b64": "", "zone": zone, "rules": rules_so_far}
            else:
                s["phase"] = "proponiendo_regla"
                sys_p = _build_system(
                    f"✅ Regla {rule_num} guardada. Les faltan {3 - rules_count} reglas (máximo 3). "
                    f"Pregunta si quiere agregar otra regla. Pídile que te cuente qué más le preocupa."
                )
                msgs = _build_messages(sys_p)
                answer = await _qwen(msgs)
                s["msgs"].append({"role": "assistant", "content": answer})
                eva_sessions[user_id] = s
                return {"success": True, "response": answer, "ready_to_confirm": False, "camera_saved": False, "camera_image_b64": "", "zone": zone, "rules": rules_so_far}

        elif is_reject:
            s["phase"] = "proponiendo_regla"
            sys_p = _build_system(
                f"El usuario rechazó o quiere modificar la regla (mensaje: '{message}'). "
                f"Pídele que te diga cómo quiere que sea la regla y ajusta según su respuesta. "
                f"Sé flexible y colaborativo."
            )
            msgs = _build_messages(sys_p)
            answer = await _qwen(msgs)
            s["msgs"].append({"role": "assistant", "content": answer})
            eva_sessions[user_id] = s
            return {"success": True, "response": answer, "ready_to_confirm": False, "camera_saved": False, "camera_image_b64": "", "zone": zone, "rules": rules_so_far}

        else:
            s["phase"] = "proponiendo_regla"
            sys_p = _build_system(
                f"El usuario respondió algo ambiguo (mensaje: '{message}'). "
                f"Pregúntale directamente: ¿Te parece bien la regla que te propuse o quieres que la ajuste?"
            )
            msgs = _build_messages(sys_p)
            answer = await _qwen(msgs)
            s["msgs"].append({"role": "assistant", "content": answer})
            eva_sessions[user_id] = s
            return {"success": True, "response": answer, "ready_to_confirm": False, "camera_saved": False, "camera_image_b64": "", "zone": zone, "rules": rules_so_far}

    # ── FASE: CONFIRMANDO ──
    if current_phase == "confirmando":
        lower = message.lower()
        final_confirm = ["si", "sí", "acepto", "apruebo", "confirmo", "listo", "dale", "vamos", "esta bien", "está bien", "de acuerdo", "perfecto"]
        if any(w in lower for w in final_confirm):
            pass
        sys_p = _build_system(
            f"El usuario respondió: '{message}'. "
            f"Muestra un RESUMEN completo de la configuración: "
            f"zona={zone}, reglas={rules_so_far}, horario={schedule.get('open','08:00')}-{schedule.get('close','22:00')}. "
            f"Pide confirmación final. Si confirma, genera [CAMERA_CONFIG] con los datos reales. "
            f"Formato: [CAMERA_CONFIG]{{...}}[/CAMERA_CONFIG]"
        )
        msgs = _build_messages(sys_p)
        answer = await _qwen(msgs, max_tok=500)
        s["msgs"].append({"role": "assistant", "content": answer})

    # ── FASE: Default (cualquier otra fase, dejar a Qwen responder) ──
    if current_phase not in ("confirmando",):
        sys_p = _build_system(
            f"El usuario dijo: '{message}'. "
            f"Continúa la configuración de forma natural según el contexto. "
            f"Si ya tienes suficiente información, muestra un resumen y pide confirmación final "
            f"generando [CAMERA_CONFIG] con los datos reales."
        )
        msgs = _build_messages(sys_p)
        answer = await _qwen(msgs)
        s["msgs"].append({"role": "assistant", "content": answer})

    # ── Parsear CAMERA_CONFIG ──
    camera_image_b64 = ""
    camera_saved = False

    if "[CAMERA_CONFIG]" in answer:
        match = re.search(r'\[CAMERA_CONFIG\](.*?)\[/CAMERA_CONFIG\]', answer, re.DOTALL)
        if match:
            try:
                camera_config = json.loads(match.group(1).strip())
                camera_id = camera_config.get("camera_id", "unknown")
                if camera_id == "AUTO":
                    camera_id = s.get("camera_id", f"cam_{int(time.time())}")
                    camera_config["camera_id"] = camera_id

                storage_path = get_user_storage_path(user_id, "founder")
                camera_dir = f"{storage_path}/cameras/{camera_id}"
                os.makedirs(camera_dir, exist_ok=True)
                with open(f"{camera_dir}/camera.json", "w") as f:
                    json.dump(camera_config, f, indent=2)

                uf = _find_user_json(user_id)
                if uf:
                    with open(uf) as f:
                        user_data = json.load(f)
                else:
                    user_data = {"user_id": user_id, "cameras": []}
                user_data.setdefault("cameras", [])
                existing = [c for c in user_data["cameras"] if c.get("camera_id") != camera_id]
                existing.append({
                    "camera_id": camera_id,
                    "name": camera_config.get("name", camera_id),
                    "zone": camera_config.get("zone", "")
                })
                user_data["cameras"] = existing
                compat_dir = f"{STORAGE_ROOT}/users/{user_id}"
                os.makedirs(compat_dir, exist_ok=True)
                with open(f"{compat_dir}/user.json", "w") as f:
                    json.dump(user_data, f, indent=2)

                camera_saved = True
                s["configured"] = True
                s["camera_id"] = camera_id
                s["phase"] = "completado"
                logger.info(f"Camera saved: {camera_id} for user {user_id}")
            except json.JSONDecodeError as e:
                logger.error(f"Failed to parse CAMERA_CONFIG JSON: {e}")
            except Exception as e:
                logger.error(f"Failed to save camera: {e}")

        answer = re.sub(r'\[CAMERA_CONFIG\].*?\[/CAMERA_CONFIG\]', '', answer, flags=re.DOTALL).strip()
        if not answer or len(answer) < 20:
            answer = "✅ ¡Listo! Tu cámara está configurada y vigilando."

    eva_sessions[user_id] = s

    return {
        "success": True,
        "response": answer,
        "ready_to_confirm": camera_saved,
        "camera_saved": camera_saved,
        "camera_image_b64": "",
        "zone": zone,
        "rules": rules_so_far
    }

@app.post("/config/confirm")
async def config_confirm(request: dict):
    return {"success": True}

@app.post("/config/camera")
async def config_camera(request: dict):
    """Configura una cámara - recibe business_id, camera_id, config"""
    user_id = request.get("user_id", "")
    camera_id = request.get("camera_id", "")
    camera_config = request.get("config", {})
    
    if not user_id or not camera_id:
        raise HTTPException(status_code=400, detail="user_id y camera_id requeridos")
    
    # Get storage path
    user_file = _find_user_json(user_id)
    if not user_file:
        # Create user path
        plan = camera_config.get("plan", "free")
        storage_path = get_user_storage_path(user_id, plan)
    else:
        storage_path = os.path.dirname(user_file)
    
    # Create camera directory
    camera_dir = f"{storage_path}/cameras/{camera_id}"
    os.makedirs(camera_dir, exist_ok=True)
    
    # Save camera.json
    camera_file = f"{camera_dir}/camera.json"
    camera_data = {
        "camera_id": camera_id,
        "user_id": user_id,
        "created_at": int(time.time()),
        "name": camera_config.get("name", camera_id),
        "zone": camera_config.get("zone", "principal"),
        "vigilance_prompt": camera_config.get("vigilance_prompt", ""),
        "rules": camera_config.get("rules", [])
    }
    with open(camera_file, "w") as f:
        json.dump(camera_data, f, indent=2)
    
    # Update user.json
    if user_file:
        with open(user_file) as f:
            user_data = json.load(f)
    else:
        user_data = {"user_id": user_id, "cameras": []}
    
    user_data.setdefault("cameras", [])
    existing = [c for c in user_data["cameras"] if c.get("camera_id") != camera_id]
    existing.append({
        "camera_id": camera_id,
        "name": camera_data["name"],
        "zone": camera_data["zone"]
    })
    user_data["cameras"] = existing
    
    # Preserve business context if exists
    if "business_name" in camera_config:
        user_data["business_name"] = camera_config["business_name"]
    if "business_type" in camera_config:
        user_data["business_type"] = camera_config["business_type"]
    if "business_hours" in camera_config:
        user_data["business_hours"] = camera_config["business_hours"]
    
    with open(user_file if user_file else f"{storage_path}/user.json", "w") as f:
        json.dump(user_data, f, indent=2)
    
    return {
        "success": True,
        "camera_id": camera_id,
        "storage_path": storage_path
    }

