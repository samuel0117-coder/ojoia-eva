@app.get("/api/events")
async def api_get_events(user_id: str, limit: int = 50):
    """Obtener eventos de usuario"""
    events = []
    cam_names = {}
    user_file = f"{STORAGE_ROOT}/users/{user_id}/user.json"
    if os.path.exists(user_file):
        with open(user_file) as f:
            ud = json.load(f)
        for cam in ud.get("cameras", []):
            cam_names[cam.get("camera_id", "")] = cam.get("name", "")

    seen = set()
    for cam_id, events_dir in _resolve_user_events_dirs(user_id):
        if not os.path.exists(events_dir):
            continue
        for fname in sorted(os.listdir(events_dir), reverse=True):
            if not fname.endswith('.json'):
                continue
            if len(events) >= limit:
                break
            with open(f"{events_dir}/{fname}") as f:
                ev = json.load(f)
            eid = ev.get("event_id", fname)
            if eid in seen:
                continue
            seen.add(eid)
            ev["camera_name"] = cam_names.get(ev.get("camera_id", ""), cam_id if cam_id != "_global" else "Cámara")
            events.append(ev)
    return {"events": events}


@app.get("/api/events/{event_id}")
async def api_get_event(event_id: str, user_id: str):
    """Obtener evento específico con imagen - busca en todas las carpetas de cámara"""
    event_file = None
    img_file = None

    for _cam_id, events_dir in _resolve_user_events_dirs(user_id):
        ef = f"{events_dir}/{event_id}.json"
        if os.path.exists(ef):
            event_file = ef
            img_file = f"{events_dir}/{event_id}.jpg"
            break

    if not event_file or not os.path.exists(event_file):
        raise HTTPException(status_code=404, detail="Evento no encontrado")

    with open(event_file) as f:
        event = json.load(f)

    # Agregar imagen en base64 si existe
    if img_file and os.path.exists(img_file):
        with open(img_file, "rb") as f:
            import base64
            event["frame_b64"] = base64.b64encode(f.read()).decode('utf-8')

    # Normalizar estructura para frontend
    event["qwen"] = {
        "violation": event.get("event_type") == "violation",
        "description": event.get("metadata", {}).get("qwen_analysis", "")
    }
    event["yolo"] = {"count": 1}
    event["grid_b64"] = event.get("metadata", {}).get("grid_b64", "")

    return event


@app.get("/api/grid/latest")
async def api_get_latest_grid(user_id: str = "default"):
    """Obtener último grid de frames"""
    grid_info = orchestrator.grid.get_grid_info()
    grid_b64 = ""
    
    if grid_info["frame_count"] > 0:
        grid_img = orchestrator.grid.get_grid_image()
        import base64
        grid_b64 = base64.b64encode(grid_img).decode('utf-8')
    
    return {
        "frames_used": grid_info["frame_count"],
        "grid_b64": grid_b64,
        "camera_ids": grid_info["camera_ids"]
    }


@app.get("/api/cameras/{camera_id}/grid")
async def api_get_camera_grid(camera_id: str):
    """Último frame individual de una cámara específica"""
    last_cam_id = orchestrator.grid.get_last_camera_id()
    frame_bytes = orchestrator.grid.get_last_frame_bytes() if last_cam_id == camera_id else b''
    image_b64 = base64.b64encode(frame_bytes).decode("utf-8") if frame_bytes else ""
    return {
        "success": True,
        "camera_id": camera_id,
        "image_b64": image_b64,
        "yolo": {"count": 0},
        "qwen": {"violation": False}
    }


@app.get("/api/violations")
async def api_get_violations(user_id: str, limit: int = 20):
    """Obtener violaciones/alertas de usuario"""
    violations = []
    for _cam_id, events_dir in _resolve_user_events_dirs(user_id):
        if not os.path.exists(events_dir):
            continue
        for fname in sorted(os.listdir(events_dir), reverse=True):
            if not fname.endswith('.json'):
                continue
            if len(violations) >= limit:
                break
            with open(f"{events_dir}/{fname}") as f:
                event = json.load(f)
                if event.get("event_type") == "violation":
                    violations.append(event)
    return {"violations": violations}


