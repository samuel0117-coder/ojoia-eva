@app.post("/api/user/profile")
async def update_user_profile(request: Request):
    """Actualizar perfil del usuario incluyendo prompt y reglas de vigilancia"""
    data = await request.json()
    user_id = data.get("user_id", "")
    if not user_id:
        raise HTTPException(status_code=400, detail="user_id required")
    
    user_file = f"{STORAGE_ROOT}/users/{user_id}/user.json"
    os.makedirs(os.path.dirname(user_file), exist_ok=True)
    
    user_data = {}
    if os.path.exists(user_file):
        with open(user_file) as f:
            user_data = json.load(f)
    
    # Actualizar campos
    if "vigilance_prompt" in data:
        user_data["vigilance_prompt"] = data["vigilance_prompt"]
    if "vigilance_rules" in data:
        user_data["vigilance_rules"] = data["vigilance_rules"]
    
    with open(user_file, "w") as f:
        json.dump(user_data, f, indent=2)
    
    return {"success": True}

@app.get("/api/user/events")
async def get_user_events(user_id: str, date: str = None, filter: str = None, limit: int = 0):
    """Obtener eventos de usuario. Puede filtrar por ?date=hoy o ?filter=today|alerts|all&limit=N"""
    events = []
    now = int(time.time())
    start_of_today = now - (now % 86400)

    # Cargar nombres de cámaras
    cam_names = {}
    user_file = f"{STORAGE_ROOT}/users/{user_id}/user.json"
    if os.path.exists(user_file):
        with open(user_file) as f:
            ud = json.load(f)
        for cam in ud.get("cameras", []):
            cam_names[cam.get("camera_id", "")] = cam.get("name", "")

    for cam_id, events_dir in _resolve_user_events_dirs(user_id):
        if not os.path.exists(events_dir):
            continue
        for fname in sorted(os.listdir(events_dir), reverse=True):
            if not fname.endswith('.json'):
                continue
            event_file = f"{events_dir}/{fname}"
            with open(event_file) as f:
                ev = json.load(f)
            if date == 'hoy' or filter == 'today':
                if ev.get("timestamp", 0) < start_of_today:
                    continue
            if filter == 'alerts':
                if not ev.get("event_type") == "violation":
                    continue
            cid = ev.get("camera_id", "")
            ev["camera_name"] = cam_names.get(cid, cam_id if cam_id != "_global" else cid)
            # Strip huge grid_b64 from metadata to reduce payload
            if "metadata" in ev and "grid_b64" in ev["metadata"]:
                del ev["metadata"]["grid_b64"]
            # Normalizar estructura para frontend: qwen.violation, qwen.description, yolo.count
            qa = ev.get("metadata", {}).get("qwen_analysis", "")[:200]  # Limitar tamaño
            ev["qwen"] = {
                "violation": ev.get("event_type") == "violation",
                "description": qa
            }
            ev["yolo"] = {"count": 1}  # Default, since YOLO count was per-frame
            # No incluir grid_b64 ni frame_b64 en lista (muy pesado) - usar stats endpoint separado
            events.append(ev)
            if limit and len(events) >= limit:
                return {"events": events}

    return {"events": events}

@app.get("/api/cameras")
async def get_cameras(user_id: str):
