    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# Agregar middleware para CORS y evitar cache
@app.middleware("http")
async def add_cors_and_no_cache(request: Request, call_next):
    if request.method == "OPTIONS":
        from fastapi.responses import Response
        return Response(
            status_code=200,
            headers={
                "Access-Control-Allow-Origin": "*",
                "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS",
                "Access-Control-Allow-Headers": "*",
                "Access-Control-Max-Age": "86400",
            }
        )
    response = await call_next(request)
    response.headers["Access-Control-Allow-Origin"] = "*"
    response.headers["Access-Control-Allow-Methods"] = "GET, POST, PUT, DELETE, OPTIONS"
    response.headers["Access-Control-Allow-Headers"] = "*"
    response.headers["Cache-Control"] = "no-store, no-cache, must-revalidate, max-age=0"
    response.headers["Pragma"] = "no-cache"
    response.headers["Expires"] = "0"
    return response


def get_disk_config() -> dict:
    """Lee la configuración de discos desde disco; si no existe, crea la por defecto."""
    if os.path.exists(DISKS_CONFIG_FILE):
        with open(DISKS_CONFIG_FILE) as f:
            cfg = json.load(f)
        if "disks" in cfg:
            return cfg
    # Si no existe el archivo o está corrupto, retorna defaults y lo crea de inmediato
    save_disk_config(DEFAULT_DISK_CONFIG)
    return dict(DEFAULT_DISK_CONFIG)


def save_disk_config(cfg: dict) -> None:
    """Guarda la configuración de discos a disco de forma atómica."""
    os.makedirs(os.path.dirname(DISKS_CONFIG_FILE), exist_ok=True)
    tmp = DISKS_CONFIG_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(cfg, f, indent=2)
    os.replace(tmp, DISKS_CONFIG_FILE)


def get_user_storage_path(user_id: str, plan: str = "founder") -> str:
    """
    Resuelve la ruta de almacenamiento del usuario consultando la config de discos.
    Jerarquía:
      1. Lee disks_config.json → OBTIENE disco con plan asignado
      2. Si el plan tiene priority_disk definido, usa ese disco
      3. Si no, elige el disco con más espacio libre
      4. Forma ruta: {disk.mount}/{disk.user_folder}/{user_id}/
    Por defecto cae en: /home/sam/storage/users/{user_id}/
    """
    cfg = get_disk_config()
    disks = cfg.get("disks", [])
    plans = cfg.get("plans", {})

    target_plan = plans.get(plan, plans.get("founder", {}))
    priority_disk = target_plan.get("priority_disk", "")

    # Seleccionar disco
    selected = None
    if priority_disk:
        for d in disks:
            if d.get("mount") == priority_disk:
                selected = d
                break

    if not selected:
        # Escoger disco con más espacio libre
        max_free = -1
        for d in disks:
            free = d.get("free_gb", 0) or 0
            if free > max_free:
                max_free = free
                selected = d

    if not selected and disks:
        selected = disks[0]

    if not selected:
        selected = {"mount": STORAGE_ROOT, "user_folder": "users"}

    return f"{selected['mount']}/{selected['user_folder'].strip('/')}/{user_id}"


def _find_user_json(user_id: str) -> str | None:
    """Busca user.json de un usuario en todos los discos configurados. Devuelve la ruta o None."""
    # 1) Buscar en la ruta resuelta
    for plan in ("founder", "free", "pro"):
        path = get_user_storage_path(user_id, plan)
        candidate = f"{path}/user.json"
        if os.path.exists(candidate):
            return candidate
    # 2) Fallback: STORAGE_ROOT/users (compat)
    compat = f"{STORAGE_ROOT}/users/{user_id}/user.json"
    if os.path.exists(compat):
        return compat
    return None


def _resolve_user_events_dirs(user_id: str):
    """
    Devuelve todas las carpetas de eventos de un usuario.
    Explora todas las subcarpetas de cámara bajo la ruta de almacenamiento del usuario.
    También incluye la carpeta events/ antigua (compatibilidad).
    """
    base = get_user_storage_path(user_id, "founder")
    # Fallback para detectar el plan real
    try:
        user_file = f"{STORAGE_ROOT}/users/{user_id}/user.json"
        if os.path.exists(user_file):
            with open(user_file) as f:
                ud = json.load(f)
            base = get_user_storage_path(user_id, ud.get("plan", "founder"))
    except Exception:
        pass

    dirs = []
    # nueva estructura: cameras/{cam_id}/events/
    cameras_dir = f"{base}/cameras"
    if os.path.exists(cameras_dir):
        for cam_id in os.listdir(cameras_dir):
            cam_events = f"{cameras_dir}/{cam_id}/events"
            if os.path.isdir(cam_events):
                dirs.append((cam_id, cam_events))
    # compatibilidad: events/ directamente
    legacy_dir = f"{base}/events"
    if os.path.isdir(legacy_dir):
        dirs.append(("_global", legacy_dir))
    return dirs


class AnalysisRequest(BaseModel):
    prompt: str = "Describe this image briefly."
    priority: int = 10
    max_tokens: int = 100

@app.post("/analyze")
async def analyze_image(
    image: UploadFile = File(...),
    request: AnalysisRequest = None
):
    if request is None:
        request = AnalysisRequest()
    try:
        img_bytes = await image.read()
        resized = resize_image(img_bytes, max_size=512)
        result = await orchestrator.submit(
            resized, 
            request.prompt, 
            priority=request.priority
        )
        return {
            "success": True,
            "answer": result,
            "image_size": len(resized),
            "priority": request.priority
        }
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

@app.get("/health")
async def health():
    try:
        async with httpx.AsyncClient(timeout=5) as client:
            resp = await client.get("http://localhost:8004/health")
            status = "ok" if resp.status_code == 200 else "error"
    except:
        status = "error"
    return {"status": status, "qwen": "healthy"}


@app.get("/frames/latest")
async def get_latest_frame():
    """Último frame individual recibido por las cámaras"""
    frame_bytes = orchestrator.grid.get_last_frame_bytes()
    camera_id = orchestrator.grid.get_last_camera_id()
    yolo_count = orchestrator.grid.get_last_yolo_count()
    image_b64 = base64.b64encode(frame_bytes).decode("utf-8") if frame_bytes else ""
    return {
        "success": True,
        "image_b64": image_b64,
        "camera_id": camera_id,
        "yolo": {"count": yolo_count},
        "qwen": {"violation": False},
        "metadata": {"camera_id": camera_id},
        "has_frame": bool(frame_bytes)
    }


@app.get("/grid/latest")
async def get_latest_grid(partial: int = 1):
    """Último grid 4×4 de frames acumulados"""
    grid_info = orchestrator.grid.get_grid_info()
    grid_b64 = ""
    if grid_info["frame_count"] > 0:
        grid_img = orchestrator.grid.get_grid_image()
        grid_b64 = base64.b64encode(grid_img).decode("utf-8")
    return {
        "frames_used": grid_info["frame_count"],
        "grid_b64": grid_b64,
        "camera_ids": grid_info["camera_ids"],
        "partial": bool(partial)
    }


@app.post("/auth/firebase/verify")
async def verify_firebase(request: dict):
    id_token = request.get("id_token", "") or request.get("idToken", "")
    if not id_token:
        raise HTTPException(status_code=400, detail="Missing idToken")
    try:
        decoded = auth.verify_id_token(id_token)
        uid = decoded["uid"]
        email = decoded.get("email", "")
        name = request.get("name", "")
        business_name = request.get("business_name", "")
        business_type = request.get("business_type", "")
        plan = request.get("plan", "founder") or "founder"

        # Resolver ruta de almacenamiento consultando config de discos
        storage_path = get_user_storage_path(uid, plan)
        
        # Extraer disk_mount desde la ruta resuelta
        disk_mount = os.path.dirname(storage_path) if storage_path else STORAGE_ROOT
        
        # Leer datos existentes si los hay
        compat_dir = f"{STORAGE_ROOT}/users/{uid}"
        existing_data = {}
        existing_file = f"{storage_path}/user.json" if os.path.exists(f"{storage_path}/user.json") else f"{compat_dir}/user.json"
        if os.path.exists(existing_file):
            try:
                with open(existing_file) as f:
                    existing_data = json.load(f)
            except:
                pass
        
        user_data = {
            "user_id": uid,
            "name": name or decoded.get("name", "") or existing_data.get("name", ""),
            "email": email or existing_data.get("email", ""),
            "business_name": business_name or existing_data.get("business_name", ""),
            "business_type": business_type or existing_data.get("business_type", ""),
            "plan": plan,
            "status": "active",
            "created_at": existing_data.get("created_at", str(int(time.time()))),
            "cameras": existing_data.get("cameras", []),
            "disk_mount": disk_mount,
            "storage_path": storage_path,
            "fcm_tokens": existing_data.get("fcm_tokens", []),
            "vigilance_prompt": existing_data.get("vigilance_prompt", ""),
            "vigilance_rules": existing_data.get("vigilance_rules", [])
        }
        
        # Crear carpeta del usuario en el disco asignado
        os.makedirs(storage_path, exist_ok=True)
        with open(f"{storage_path}/user.json", "w") as f:
            json.dump(user_data, f, indent=2)
        
        # Crear también symlink o referencia en STORAGE_ROOT/users/ para compatibilidad
        os.makedirs(compat_dir, exist_ok=True)
        if not os.path.exists(f"{compat_dir}/user.json") or os.path.getsize(f"{compat_dir}/user.json") < 100:
            with open(f"{compat_dir}/user.json", "w") as f:
                json.dump(user_data, f, indent=2)

        return {
            "success": True,
            "user_id": uid,
            "email": email,
            "name": user_data["name"],
            "business_name": business_name,
            "plan": plan,
            "storage_path": storage_path
        }
    except Exception as e:
        return {"success": False, "error": str(e)}

