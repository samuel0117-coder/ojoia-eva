@app.post("/api/event/{event_id}/dismiss")
async def dismiss_event(event_id: str, request: dict = None):
    """Marcar evento como revisado / falsa alarma"""
    user_id = (request or {}).get("user_id", "")
    event_file = None
    for _cam_id, events_dir in _resolve_user_events_dirs(user_id):
        ef = f"{events_dir}/{event_id}.json"
        if os.path.exists(ef):
            event_file = ef
            break

    if not event_file or not os.path.exists(event_file):
        raise HTTPException(status_code=404, detail="Evento no encontrado")

    with open(event_file) as f:
        ev = json.load(f)
    ev["dismissed"] = True
    ev["dismissed_at"] = int(time.time())
    with open(event_file, "w") as f:
        json.dump(ev, f, indent=2)
    logger.info(f"Evento {event_id} marcado como revisado por {user_id}")
    return {"success": True}


@app.post("/api/payment/upload")
async def upload_payment_receipt(
    request: Request,
    user_id: str = Form(...),
    receipt: UploadFile = File(...)
):
    """Recibir comprobante de pago de usuario"""
    upload_dir = f"{STORAGE_ROOT}/receipts"
    os.makedirs(upload_dir, exist_ok=True)
    ts = int(time.time())
    filename = f"{user_id}_{ts}_{receipt.filename}"
    filepath = f"{upload_dir}/{filename}"
    try:
        content = await receipt.read()
        with open(filepath, "wb") as f:
            f.write(content)
        logger.info(f"Comprobante de pago recibido: {filename} ({len(content)} bytes)")
        return {"success": True, "filename": filename, "size": len(content)}
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


