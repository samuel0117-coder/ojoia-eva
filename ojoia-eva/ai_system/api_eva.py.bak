@app.post("/frames/ingest")
async def ingest_frame_form(
    request: Request,
    camera_id: str = Form(...),
    user_id: str = Form("default"),
    image: UploadFile = File(...)
):
    return await _process_ingest(request, camera_id, user_id, image)


@app.post("/ingest/frame")
async def ingest_frame_raw(request: Request):
    """Compat: ESP32 envía bytes puros (image/jpeg, image/bmp, etc.)"""
    try:
        body = await request.body()
        ct = request.headers.get("content-type", "")
        qp = request.query_params
        cid = qp.get("camera_id", "")
        if not cid:
            m = re.search(r'camera_id=(\w+)', str(request.url))
            cid = m.group(1) if m else "unknown"
        uid = qp.get("user_id", "default")
        m = re.search(r'user_id=(\w+)', str(request.url))
        uid = m.group(1) if m else uid
        if not body:
            return {"success": False, "error": "empty body"}
        from io import BytesIO
        fake_file = UploadFile(filename=f"{cid}.jpg", file=BytesIO(body))
        return await _process_ingest(request, cid, uid, fake_file)
    except Exception as e:
        return {"success": False, "error": str(e)}


@app.post("/ingest/photo")
@app.post("/ingest/snapshot")
async def ingest_photo_stack(
    request: Request,
    filename: str = Form(None),
    camera_id: str = Form(None),
    user_id: str = Form(None),
    image: UploadFile = File(None)
):
    """Compatibilidad con ESP32 que envía sin campo 'camera_id' form"""
    cid = camera_id or filename or "unknown"
    uid = user_id or "default"
    if image is None:
        body = await request.body()
        import mimetypes
        ct = request.headers.get("content-type", "")
        if "image" in ct and body:
            from io import BytesIO
            image = UploadFile(
                filename=f"{cid}.jpg",
                file=BytesIO(body),
                content_type=ct
            )
        else:
            raise HTTPException(status_code=400, detail="No image provided")
    return await _process_ingest(request, cid, uid, image)


async def _process_ingest(request: Request, camera_id: str, user_id: str, image: UploadFile):

    try:
        client_ip = request.client.host if request.client else "unknown"
        # Resolve user_id from camera if needed
        user_id = _resolve_user_id(camera_id, user_id, client_ip)
        
        img_bytes = await image.read()
        frame_size = len(img_bytes)

        logger.info(f"📸 Frame recibido - IP: {client_ip} | Camera: {camera_id} | User: {user_id} | Size: {frame_size} bytes")

        # 1. Llamar YOLO para detección de objetos
        yolo_count = 0
        try:
            async with httpx.AsyncClient(timeout=10) as client:
                yolo_resp = await client.post(
                    "http://localhost:8002/detect",
                    files={"image": ("frame.jpg", img_bytes, "image/jpeg")},
                )
                if yolo_resp.status_code == 200:
                    yolo_data = yolo_resp.json()
                    yolo_count = yolo_data.get("count", 0)
        except Exception as yolo_err:
            logger.warning(f"YOLO no disponible: {yolo_err}")
            yolo_count = 0

        logger.info(f"👁 YOLO detectó: {yolo_count} objetos")

        # 2. Solo agregar al grid si YOLO detectó objetos
        grid_result = {"frame_count": 0, "grid_full": False, "ready_for_analysis": False}
        if yolo_count > 0:
            # Cargar vigilancia del usuario para pasar al grid
            v_prompt, v_rules = "", ""
            if user_id and user_id != "default":
                uf = f"{STORAGE_ROOT}/users/{user_id}/user.json"
                if os.path.exists(uf):
                    try:
                        with open(uf) as f:
                            ud = json.load(f)
                        v_prompt = ud.get("vigilance_prompt", "")
                        v_rules_raw = ud.get("vigilance_rules", "")
                        # Handle both string and array format
                        v_rules = v_rules_raw if isinstance(v_rules_raw, str) else "\n".join(v_rules_raw) if v_rules_raw else ""
                    except: pass
            grid_result = orchestrator.add_frame(
                img_bytes, camera_id, user_id, yolo_count=yolo_count,
                vigilance_prompt=v_prompt, vigilance_rules=v_rules
            )
            logger.info(f"✅ Frame procesado - Camera: {camera_id} | Grid: {grid_result['frame_count']}/16 | YOLO: {yolo_count}")
        else:
            logger.info(f"❌ Frame omitido - sin objetos YOLO | Camera: {camera_id}")

        # 3. Registrar cámara en user.json si es nueva
        if user_id and user_id != "default":
            user_file = f"{STORAGE_ROOT}/users/{user_id}/user.json"
            if os.path.exists(user_file):
                with open(user_file) as f:
                    ud = json.load(f)
                existing_ids = [c.get("camera_id") for c in ud.get("cameras", [])]
                if camera_id not in existing_ids:
                    ud.setdefault("cameras", []).append({
                        "camera_id": camera_id,
                        "name": camera_id,
                        "zone": "",
                        "active": True,
                        "first_seen": int(time.time()),
                        "last_frame": int(time.time())
                    })
                    with open(user_file, "w") as f:
                        json.dump(ud, f, indent=2)

        return {
            "success": True,
            "camera_id": camera_id,
            "user_id": user_id,
            "client_ip": client_ip,
            "frame_size": frame_size,
            "timestamp": datetime.now().isoformat(),
            "yolo": {"count": yolo_count},
            **grid_result
        }
    except Exception as e:
        logger.error(f"❌ Error procesando frame: {str(e)}")
        return {"success": False, "error": str(e)}

@app.post("/grid/analyze")
async def analyze_grid(request: dict):
    user_id = request.get("user_id", "default")
    prompt = request.get("prompt")
    vigilance_prompt = request.get("vigilance_prompt", "")
    vigilance_rules = request.get("vigilance_rules", "")
    
    # Si no se proveen, cargar del perfil del usuario
    if not vigilance_prompt or not vigilance_rules:
        user_file = f"{STORAGE_ROOT}/users/{user_id}/user.json"
        if os.path.exists(user_file):
            with open(user_file) as f:
                user_data = json.load(f)
            vigilance_prompt = vigilance_prompt or user_data.get("vigilance_prompt", "")
            v_rules_raw = vigilance_rules or user_data.get("vigilance_rules", [])
            vigilance_rules = v_rules_raw if isinstance(v_rules_raw, str) else "\n".join(v_rules_raw) if v_rules_raw else ""
    
    result = await orchestrator.process_grid(prompt, vigilance_prompt, vigilance_rules)
    # Asegurar que no haya bytes en la respuesta
    if "violation_frame" in result and result["violation_frame"]:
        result["violation_frame"] = "[Frame data excluded from response]"
    return result

@app.post("/config/reset")
async def config_reset(request: dict):
    """Reset Eva conversation session."""
    user_id = request.get("user_id", "")
    eva_sessions.pop(user_id, None)
    return {"success": True, "message": "Sesión reiniciada"}


@app.get("/config/session")
