eva_sessions: dict = {}

def _resolve_user_id(camera_id: str, provided_user_id: str, client_ip: str = "unknown") -> str:
    """Resolve user_id from camera_id, IP, or fallback if provided_user_id is default."""
    if provided_user_id and provided_user_id != "default":
        return provided_user_id
    
    # Search for camera in all user.json files, prioritizing founder plan with FCM tokens
    try:
        users_dir = f"{STORAGE_ROOT}/users"
        if os.path.isdir(users_dir):
            founder_match = None
            any_match = None
            for user_folder in os.listdir(users_dir):
                user_file = f"{users_dir}/{user_folder}/user.json"
                if os.path.isfile(user_file):
                    try:
                        with open(user_file) as f:
                            ud = json.load(f)
                        for cam in ud.get("cameras", []):
                            if cam.get("camera_id") == camera_id:
                                uid = ud.get("user_id", user_folder)
                                plan = ud.get("plan", "")
                                has_fcm = bool(ud.get("fcm_tokens"))
                                if plan == "founder" and has_fcm:
                                    founder_match = uid
                                else:
                                    any_match = uid
                    except:
                        pass
            if founder_match:
                return founder_match
            if any_match:
                return any_match
    except:
        pass
    
    return provided_user_id

DEFAULT_DISK_CONFIG = {
    "disks": [
        {"mount": STORAGE_ROOT, "label": "Storage", "total_gb": 1000, "used_gb": 0,
         "free_gb": 1000, "user_folder": "users"}
    ],
    "plans": {
        "founder": {"max_storage_gb": 500, "max_cameras": 5, "priority_disk": ""},
        "pro":     {"max_storage_gb": 250, "max_cameras": 3, "priority_disk": ""},
        "free":    {"max_storage_gb": 10,  "max_cameras": 1, "priority_disk": ""}
    },
    "disk_fill_threshold_pct": 90,
    "default_cleanup_hour": 23,
    "default_frames_ttl_hours": 24,
    "default_sessions_ttl_days": 7
}

app = FastAPI(title="Eva Vision API", version="1.0")

