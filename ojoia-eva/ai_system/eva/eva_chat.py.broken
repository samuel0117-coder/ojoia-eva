"""
Eva v12 — Flujo Determinista Completo con Reglas Inteligentes
Backend controla TODO. Eva solo analiza imagen y recomienda reglas.
"""
import base64
import time
import logging
from typing import Dict, Any, Optional
import httpx

from .state_machine import EvaPhase

logger = logging.getLogger(__name__)

QWEN_URL = "http://localhost:8004/v1/chat/completions"
QWEN_TIMEOUT = 60
MAX_HISTORY = 6
MAX_TOKENS = 180

# ── Frame buffer para Eva (sin filtro YOLO) ──
_latest_frame: Optional[bytes] = None
_latest_frame_time: float = 0

# ── Sesiones en memoria ──
_sessions: Dict[str, Dict[str, Any]] = {}


def set_orchestrator(orch):
    global _orchestrator
    _orchestrator = orch


def ingest_frame_for_eva(frame_bytes: bytes):
    global _latest_frame, _latest_frame_time
    _latest_frame = frame_bytes
    _latest_frame_time = time.time()


def _get_session(session_id: str) -> Optional[Dict]:
    return _sessions.get(session_id)


def _load_user_data(user_id: str) -> Dict[str, str]:
    from pathlib import Path
    import json as _j
    storage_root = Path("/home/sam/storage")
    for base in [storage_root / "users" / user_id / "user.json", storage_root / user_id / "user.json"]:
        if base.exists():
            try:
                with open(base) as f:
                    data = _j.load(f)
                return {
                    "owner_name": data.get("name", "amigo"),
                    "business_name": data.get("business_name", "tu negocio"),
                    "business_type": data.get("business_type", "negocio"),
                    "schedule": data.get("schedule", {"open": "08:00", "close": "22:00"}),
                }
            except Exception:
                pass
    return {"owner_name": "amigo", "business_name": "tu negocio", "business_type": "negocio", "schedule": {"open": "08:00", "close": "22:00"}}


def _create_session(session_id: str, user_id: str, cam_id: str = "") -> Dict:
    user_data = _load_user_data(user_id)
    s = {
        "session_id": session_id, "user_id": user_id, "phase": EvaPhase.GREET.value,
        "owner_name": user_data["owner_name"], "business_name": user_data["business_name"],
        "business_type": user_data["business_type"], "zone": "", "concern": "",
        "confirmed_rules": [], "camera_id": cam_id, "camera_connected": False,
        "position_confirmed": False, "hardware_step": 0, "schedule": user_data["schedule"],
        "created_at": time.time(), "last_activity": time.time(),
        "image_b64": "", "image_desc": "", "msgs": [],
    }
    _sessions[session_id] = s
    return s


def _get_frame() -> Optional[bytes]:
    global _latest_frame
    if _latest_frame and (time.time() - _latest_frame_time < 30):
        return _latest_frame
    if _orchestrator is None:
        return None
    try:
        return _orchestrator.grid.get_last_frame_bytes()
    except Exception:
        return None


def _resize(img_bytes: bytes, max_sz: int = 400) -> str:
    try:
        from gateway_resize import resize_image
        resized = resize_image(img_bytes, max_size=max_sz)
    except Exception:
        resized = img_bytes
    return base64.b64encode(resized).decode()


async def _qwen(messages: list, max_tok: int = MAX_TOKENS, timeout: int = QWEN_TIMEOUT) -> str:
    try:
        async with httpx.AsyncClient(timeout=timeout) as cl:
            r = await cl.post(QWEN_URL, json={"model": "qwen", "messages": messages, "max_tokens": max_tok})
            if r.status_code == 200:
                return r.json()["choices"][0]["message"]["content"].strip()
    except Exception as e:
        logger.error(f"Qwen error: {e}")
    return "Disculpa, tuve un momento de confusión. ¿Puedes repetir?"


async def _describe_image(b64: str) -> str:
    try:
        raw = base64.b64decode(b64)
        small = _resize(raw, 400)
        async with httpx.AsyncClient(timeout=30) as cl:
            r = await cl.post(QWEN_URL, json={"model": "qwen", "messages": [{"role": "user", "content": [
                {"type": "image_url", "image_url": {"url": f"data:image/jpeg;base64,{small}"}},
                {"type": "text", "text": "Describe esta imagen de cámara en máximo 40 palabras. Obstáculos, iluminación, visibilidad, ángulo. Corta."}
            ]}], "max_tokens": 100})
            if r.status_code == 200:
                return r.json()["choices"][0]["message"]["content"].strip()
    except Exception as e:
        logger.error(f"describe_image error: {e}")
    return ""


def _is_yes(msg: str) -> bool:
    return msg.lower().strip() in {"si", "sí", "dale", "perfecto", "exacto", "correcto", "ok", "vale", "claro", "seguro", "bueno", "bien", "listo", "ya"}


def _is_position_ok(msg: str) -> bool:
    return any(w in msg.lower() for w in {"bien", "correcto", "perfecto", "así", "ahí", "queda bien", "se ve bien", "está bien", "ok", "listo"})


# ── HARDWARE steps (sin Qwen) ──
HARDWARE_STEPS = [
    "Perfecto 👍\n\nEnciende la cámara. La luz del frente va a encender y apagarse.\n\nAvísame cuando la veas.",
    "Ahora ve al WiFi de tu celular. Verás una red que dice OjoIA-XXXX.\n\nConéctate ahí.",
    "Abrirá una página. Elige el WiFi de tu negocio y ponle la clave.\n\nAvísame cuando la luz deje de parpadear.",
    "✅ Cámara conectada.\n\nAhora voy a revisar lo que está viendo.\n\nEsperando la primera imagen...",
]


def _save_config(session: Dict, user_id: str, storage_root: Any) -> bool:
    try:
        from .camera_builder import build_camera_config, validate_camera_config
        import json as _j
        config = build_camera_config(session, {"business_name": session.get("business_name", "tu negocio"), "business_type": session.get("business_type", "negocio"), "schedule": session.get("schedule", {"open": "08:00", "close": "22:00"})})
        if validate_camera_config(config):
            cam_dir = storage_root / "users" / user_id / "cameras" / config["camera_id"]
            cam_dir.mkdir(parents=True, exist_ok=True)
            (cam_dir / "sessions").mkdir(exist_ok=True)
            (cam_dir / "frames").mkdir(exist_ok=True)
            (cam_dir / "events").mkdir(exist_ok=True)
            (cam_dir / "camera.json").write_text(_j.dumps(config, indent=2, ensure_ascii=False))
            # Actualizar user.json
            from pathlib import Path
            uj = Path("/home/sam/storage/users") / user_id / "user.json"
            if uj.exists():
                with open(uj) as f:
                    ud = _j.load(f)
            else:
                ud = {}
            rules_es = [r.get("es", str(r)) if isinstance(r, dict) else str(r) for r in session.get("confirmed_rules", [])]
            ud["vigilance_prompt"] = config.get("system_prompt", "")
            ud["vigilance_rules"] = rules_es
            ud["scanner_question"] = config.get("scanner_question", "")
            ud["yolo_triggers"] = config.get("yolo_triggers", ["person"])
            with open(uj, "w") as f:
                _j.dump(ud, f, indent=2, ensure_ascii=False)
            logger.info(f"📷 Camera + vigilance saved: {config['camera_id']}")
            return True
    except Exception as e:
        logger.error(f"Save config error: {e}")
    return False


def _build_response(session: Dict, text: str, img_b64: str = "") -> Dict:
    confirmed = session.get("confirmed_rules", [])
    rules_text = []
    for r in confirmed:
        if isinstance(r, dict):
            rules_text.append(r.get("es", ""))
        else:
            rules_text.append(str(r))
    return {
        "success": True, "response": text,
        "image_url": f"data:image/jpeg;base64,{img_b64}" if img_b64 else "",
        "ready_to_confirm": session["phase"] == EvaPhase.CONFIRM.value and len(confirmed) >= 3,
        "camera_saved": session["phase"] == EvaPhase.DONE.value,
        "phase": session["phase"], "rules_count": len(confirmed),
        "rules": confirmed, "rules_text": rules_text,
        "zone": session.get("zone", ""),
        "has_image": bool(session.get("image_b64")),
    }


def _generate_scanner_question(rule_es: str, zone: str) -> str:
    t = {
        "solo despacho por el lado derecho": "Is anyone dispensing products on the left side of the counter?", "detrás del mostrador": "Is anyone behind the counter?",
        "después del horario": "Is there any person in this area after business hours?", "fuera de horario": "Is there any person outside business hours?",
        "sin pagar": "Is anyone taking items without paying?", "sin factura": "Is any transaction happening without going through the register?",
        "sin registrar": "Is any product being handed out without being scanned?", "bolsillos": "Is anyone putting items in their pockets near the register?",
        "almacén": "Is anyone entering the storage area?", "cocina": "Is anyone in the kitchen area?",
        "puerta": "Is any door being opened?", "equipo": "Is anyone carrying equipment?", "documento": "Is anyone taking documents?",
        "bolsa grande": "Is anyone carrying large bags?", "mochila": "Is anyone carrying large bags?",
    }
    rl = rule_es.lower()
    for kw, q in t.items():
        if kw in rl:
            return q
    return f"Is there any suspicious activity related to: {rl}?"


def _get_rules_database(biz_type: str, concern: str, zone: str) -> list:
    biz = biz_type.lower().strip()
    cl = concern.lower()
    z = zone
    if any(w in cl for w in ["despacho sin factura", "sin factura", "sin registrar", "no factura"]):
        cat = "despacho_sin_factura"
    elif any(w in cl for w in ["empleado", "trabajador", "interno", "ellos", "cajero"]):
        cat = "robo_empleado"
    elif any(w in cl for w in ["robo", "robar", "hurto", "ladron", "atraco"]):
        cat = "robo"
    elif any(w in cl for w in ["horario", "despues", "noche", "cerrado", "fuera"]):
        cat = "horario"
    else:
        cat = "general"
    db = {
        ("colmado", "despacho_sin_factura"): [
            {"es": f"Todo despacho en {z} debe pasar por caja registradora", "en": f"Is every transaction at {z} going through the cash register?"},
            {"es": f"Solo despacho por la derecha en {z}", "en": f"Is anyone dispensing on the left side of {z}?"},
            {"es": f"Alerta si empleado entrega productos sin escanear en {z}", "en": f"Is any employee handing products without scanning at {z}?"},
            {"es": f"Ningún producto sale de {z} sin registro", "en": f"Is any product leaving {z} without being registered?"},
        ],
        ("colmado", "robo_empleado"): [
            {"es": f"Ningún empleado detrás del mostrador en {z}", "en": f"Is any employee behind the counter at {z}?"},
            {"es": f"Alerta si empleado mete dinero/productos en bolsillos en {z}", "en": f"Is any employee putting items in pockets near {z}?"},
            {"es": f"Alerta si hay personas en {z} después del horario", "en": f"Is there any person in {z} after business hours?"},
            {"es": f"Vigilar que no despachen sin registrar en {z}", "en": f"Are employees dispensing without registering at {z}?"},
        ],
        ("colmado", "robo"): [
            {"es": f"Alerta si alguien toma objetos sin pagar en {z}", "en": f"Is anyone taking items without paying at {z}?"},
            {"es": f"Vigilar movimiento sospechoso en {z}", "en": f"Is there any suspicious movement in {z}?"},
            {"es": f"Alerta si hay personas en {z} después de cerrar", "en": f"Is there any person in {z} after closing?"},
            {"es": f"Vigilar que no se despache sin factura en {z}", "en": f"Is any product dispensed without receipt at {z}?"},
        ],
        ("colmado", "horario"): [
            {"es": f"Alerta si hay personas en {z} después del horario", "en": f"Is there any person in {z} after hours?"},
            {"es": f"Alerta si hay movimiento en {z} fuera de horario", "en": f"Is there movement in {z} outside business hours?"},
            {"es": f"Vigilar {z} las 24 horas", "en": f"Monitor {z} 24/7"},
        ],
        ("colmado", "general"): [
            {"es": f"Vigilar actividad sospechosa en {z}", "en": f"Is there any suspicious activity in {z}?"},
            {"es": f"Alerta si alguien toma objetos sin pagar", "en": f"Is anyone taking items without paying?"},
            {"es": f"Alerta si hay personas en {z} fuera de horario", "en": "Is there any person outside business hours?"},
        ],
    }
    key = (biz, cat)
    if key not in db:
        key = ("colmado", cat)
    if key not in db:
        key = ("colmado", "general")
    return db.get(key, [
        {"es": f"Vigilar actividad sospechosa en {z}", "en": f"Is there any suspicious activity in {z}?"},
        {"es": f"Alerta si hay personas en {z} fuera de horario", "en": f"Is there any person in {z} outside business hours?"},
        {"es": f"Monitorear {z} las 24 horas", "en": f"Monitor {z} 24/7"},
    ])


def _get_specific_rules(biz_type: str, concern: str, zone: str, position: int, rejects: int) -> Dict[str, str]:
    all_rules = _get_rules_database(biz_type, concern, zone)
    idx = (position + rejects) % len(all_rules)
    return all_rules[idx]


async def handle_eva_chat(user_id: str, message: str, session_id: str, cam_id: Optional[str], include_frame: bool, storage_root: Any) -> Dict[str, Any]:
    now = time.time()
    session = _get_session(session_id)
    if not session:
        session = _create_session(session_id, user_id, cam_id or "")
    session["last_activity"] = now
    if cam_id and cam_id != session.get("camera_id"):
        session["camera_id"] = cam_id

    # ═══ GREET ═══
    if message == "__greet__":
        session["phase"] = EvaPhase.GREET.value
        session["hardware_step"] = 0
        first = session.get("owner_name", "amigo").split()[0]
        biz = session.get("business_name", "tu negocio")
        text = f"Hola {first} 👋\n\nVi que tienes {biz}. Vamos a configurar una cámara nueva.\n\n¿Dónde la vas a poner?"
        session["msgs"].append({"role": "assistant", "content": text})
        return _build_response(session, text)

    old_phase = session["phase"]

    # ═══ GREET → HARDWARE ═══
    if old_phase == EvaPhase.GREET.value:
        session["zone"] = message.strip()
        session["phase"] = EvaPhase.HARDWARE.value
        session["hardware_step"] = 0
        logger.info(f"✅ Zone: {session['zone']}")

    # ═══ HARDWARE (sin Qwen) ═══
    if session["phase"] == EvaPhase.HARDWARE.value:
        step = session.get("hardware_step", 0)
        if step < len(HARDWARE_STEPS):
            text = HARDWARE_STEPS[step]
            session["hardware_step"] = step + 1
        else:
            session["phase"] = EvaPhase.WAIT_IMAGE.value
            text = "Esperando la primera imagen..."
        session["msgs"].append({"role": "user", "content": message})
        session["msgs"].append({"role": "assistant", "content": text})
        _sessions[session_id] = session
        logger.info(f"💾 Session saved: {session_id} phase={session['phase']} step={session.get('hardware_step',0)}")
        return _build_response(session, text)

    # ═══ WAIT_IMAGE → ANALYZE ═══
    if session["phase"] == EvaPhase.WAIT_IMAGE.value:
        frame = _get_frame()
        if frame and not session.get("image_b64"):
            try:
                b64 = _resize(frame, 640)
                session["image_b64"] = b64
                session["image_desc"] = await _describe_image(b64)
                session["phase"] = EvaPhase.ANALYZE.value
                session["camera_connected"] = True
                try:
                    cam_id_s = session.get("camera_id", "unknown")
                    fd = storage_root / "users" / session.get("user_id", "unknown") / "cameras" / cam_id_s / "frames"
                    fd.mkdir(parents=True, exist_ok=True)
                    with open(fd / "first.jpg", "wb") as ff:
                        ff.write(frame)
                except Exception:
                    pass
            except Exception as e:
                logger.error(f"Frame error: {e}")

        # Si el usuario confirma, pasar a PROBLEM (con o sin imagen)
        if message.lower().strip() in {"ok", "listo", "ya", "dale", "siguiente", "bien", "correcto", "perfecto", "si", "sí", "ajá", "aha", "vale"}:
            first_n = session.get("owner_name", "amigo").split()[0]
            zone = session.get("zone", "la zona")
            session["msgs"].append({"role": "user", "content": message})
            text = f"Perfecto 👍 {first_n}.\n\nLa posición quedó bien.\n\nAhora dime: ¿qué es lo que más te preocupa de seguridad en {zone}?"
            session["phase"] = EvaPhase.PROBLEM.value
            session["position_confirmed"] = True
            session["msgs"].append({"role": "assistant", "content": text})
            _sessions[session_id] = session
            return _build_response(session, text)

        if session["phase"] == EvaPhase.ANALYZE.value:
            pass  # continúa al bloque ANALYZE más abajo
        else:
            first_n = session.get("owner_name", "amigo").split()[0]
            text = f"Esperando la primera imagen...\n\nO decime 'siguiente' para continuar sin imagen."
            session["msgs"].append({"role": "user", "content": message})
            session["msgs"].append({"role": "assistant", "content": text})
            _sessions[session_id] = session
            return _build_response(session, text)

    # ═══ ANALYZE (Eva ve imagen) ═══
    if session["phase"] == EvaPhase.ANALYZE.value and old_phase != EvaPhase.ANALYZE.value:
        zone = session.get("zone", "la zona")
        img_desc = session.get("image_desc", "")
        first = session.get("owner_name", "amigo").split()[0]
        sys_p = f"Eres Eva, asistente de seguridad de OjoIA. Dominicana, directa. Máximo 3 líneas.\n\nCONTEXTO:\n- Dueño: {first}\n- Zona: {zone}\n- Descripción visual: {img_desc or 'Imagen de cámara de seguridad'}\n\nMenciona: obstáculos, iluminación, visibilidad, ángulo."
        msgs = [{"role": "system", "content": sys_p}]
        img_b64 = session.get("image_b64", "")
        if img_b64:
            msgs.append({"role": "user", "content": [
                {"type": "image_url", "image_url": {"url": f"data:image/jpeg;base64,{img_b64}"}},
                {"type": "text", "text": "¿Qué opinas de la posición de la cámara?"}
            ]})
        else:
            msgs.append({"role": "user", "content": "¿Qué opinas de la posición de la cámara?"})
        text = await _qwen(msgs, MAX_TOKENS)
        session["msgs"].append({"role": "assistant", "content": text})
        _sessions[session_id] = session
        return _build_response(session, text, img_b64=img_b64)

    if old_phase == EvaPhase.ANALYZE.value:
        if _is_position_ok(message):
            session["phase"] = EvaPhase.PROBLEM.value
            session["position_confirmed"] = True
            first = session.get("owner_name", "amigo").split()[0]
            zone = session.get("zone", "la zona")
            session["msgs"].append({"role": "user", "content": message})
            text = f"Perfecto 👍 {first}.\n\nLa posición quedó bien.\n\nAhora dime: ¿qué es lo que más te preocupa de seguridad en {zone}?"
            session["msgs"].append({"role": "assistant", "content": text})
            _sessions[session_id] = session
            return _build_response(session, text)
        else:
            sys_p = "Eres Eva, asistente de seguridad. Dominicana, cercana. Máximo 2 líneas. Responde sobre el ajuste de cámara."
            msgs = [{"role": "system", "content": sys_p}]
            msgs.extend(session["msgs"][-MAX_HISTORY:])
            msgs.append({"role": "user", "content": message})
            text = await _qwen(msgs, MAX_TOKENS)
            session["msgs"].append({"role": "user", "content": message})
            session["msgs"].append({"role": "assistant", "content": text})
            _sessions[session_id] = session
            return _build_response(session, text)

    # ═══ PROBLEM ═══
    if session["phase"] == EvaPhase.PROBLEM.value:
        zone = session.get("zone", "la zona")
        first = session.get("owner_name", "amigo").split()[0]
        if old_phase != EvaPhase.PROBLEM.value:
            text = f"Perfecto 👍 {first}.\n\nLa posición quedó bien.\n\nAhora dime: ¿qué es lo que más te preocupa de seguridad en {zone}?"
            session["msgs"].append({"role": "assistant", "content": text})
            _sessions[session_id] = session
            return _build_response(session, text)
        else:
            session["concern"] = message.strip()
            session["phase"] = EvaPhase.RULES.value
            logger.info(f"✅ Concern: {session['concern']}")
            # Proponer primera regla inmediatamente
            concern_raw = session["concern"]
            biz_type = session.get("business_type", "negocio")
            all_candidates = _get_rules_database(biz_type, concern_raw, zone)
            # Filtrar: no proponer reglas que suenen demasiado genéricas si hay mejores
            specific = [r for r in all_candidates if r["es"] != f"Vigilar actividad sospechosa in {zone}"]
            if specific:
                rule_es = specific[0]["es"]
                rule_en = specific[0]["en"]
            elif all_candidates:
                rule_es = all_candidates[0]["es"]
                rule_en = all_candidates[0]["en"]
            else:
                rule_es = f"Toda transacción en {zone} debe pasar por caja"
                en = f"Is every transaction at {zone} going through the register?"
            text = f"Entendido. {first}, te recomiendo esta 👇\n\n\"{rule_es}\"\n\n¿Te parece bien?"
            session["msgs"].append({"role": "user", "content": message})
            session["msgs"].append({"role": "assistant", "content": text})
            session["_pending_rule"] = {"es": rule_es, "en": rule_en}
            _sessions[session_id] = session
            # Return aquí para que el mensaje no se procese también en RULES
            return _build_response(session, text)
            return _build_response(session, text)

    # ═══ RULES ═══
    if session["phase"] == EvaPhase.RULES.value:
        confirmed = session.get("confirmed_rules", [])
        lower_msg = message.lower().strip()

        # ── Detectar regla personalizada (texto largo > 20 chars con contenido específico) ──
        # Ej: "MEJOR, SI UN TRABAJADOR DESPACHA SIN ENTRAR LA MERCANCIA EN LA FUNDA"
        is_custom = (len(message.strip()) > 20 and not _is_yes(message)
                     and len(confirmed) < 3)

        # ── Detectar rechazo simple (palabras cortas sin contenido) ──
        reject_words = {"no", "otra", "otra opcion", "otra opción", "dame otra",
                        "diferente", "cambiar", "no me gusta", "no sirve", "no me sirve",
                        "paso", "siguiente"}
        is_reject = (any(lower_msg == w or lower_msg.startswith(w + " ") for w in reject_words)
                     and len(confirmed) < 3 and not is_custom)

        if is_custom:
            custom_es = message.strip()
            custom_en = _generate_scanner_question(custom_es, session.get("zone", ""))
            confirmed.append({"es": custom_es, "en": custom_en})
            session["confirmed_rules"] = confirmed
            session["_pending_rule"] = None
            session["_reject_count"] = 0
            logger.info(f"✅ Regla personalizada ({len(confirmed)}/3): {custom_es[:60]}")

        elif is_reject:
            session["_pending_rule"] = None
            session["_reject_count"] = session.get("_reject_count", 0) + 1
            logger.info(f"Rechazo #{session['_reject_count']}")

        elif _is_yes(message) and len(confirmed) < 3:
            pending = session.get("_pending_rule")
            if pending:
                pes = pending.get("es", "").strip()
                cset = {r.get("es", str(r)).strip() if isinstance(r, dict) else str(r).strip() for r in confirmed}
                if pes and pes not in cset:
                    confirmed.append(pending)
            else:
                for m in reversed(session["msgs"]):
                    if m.get("role") == "assistant":
                        cm = m.get("content", "")
                        match = __import__("re").search(r'"([^"]+)"', cm)
                        if not match:
                            match = __import__("re").search(r'👇\s*\n?\n?([^\n]+)', cm)
                        if match:
                            rt = match.group(1).strip()
                            cset2 = {r.get("es", str(r)).strip() if isinstance(r, dict) else str(r).strip() for r in confirmed}
                            if rt and rt not in cset2:
                                confirmed.append({"es": rt, "en": ""})
                        break
            session["confirmed_rules"] = confirmed
            session["_pending_rule"] = None
            session["_reject_count"] = 0
            logger.info(f"✅ Regla confirmada ({len(confirmed)}/3)")

        if len(confirmed) >= 3:
            session["phase"] = EvaPhase.CONFIRM.value
        else:
            concern_raw = session.get("concern", "")
            biz_type = session.get("business_type", "negocio")
            zone = session.get("zone", "la zona")
            rn = len(confirmed)
            reject_count = session.get("_reject_count", 0)
            proposed_history = session.get("_proposed_history", [])

            # Filtrar: no proponer reglas ya confirmadas o ya propuestas antes
            cset = {r.get("es", str(r)).strip() if isinstance(r, dict) else str(r).strip() for r in confirmed}
            all_cand = _get_rules_database(biz_type, concern_raw, zone)
            available = [r for r in all_cand
                         if r["es"].strip() not in cset
                         and r["es"].strip() not in proposed_history]
            if not available:
                available = [r for r in all_cand if r["es"].strip() not in cset]
            if available:
                idx = min(rn + reject_count, len(available) - 1)
                rule = available[idx]
                rule_es = rule["es"]
                rule_en = rule["en"]
            else:
                rule_es = f"Vigilar actividad sospechosa en {zone}"
                rule_en = f"Is there any suspicious activity in {zone}?"

            proposed_history.append(rule_es.strip())
            session["_proposed_history"] = proposed_history

            presentations = [
                f"Te recomiendo esta 👇\n\n\"{rule_es}\"\n\n¿Te parece bien?",
                f"Mira esta 👇\n\n\"{rule_es}\"\n\n¿Te funciona?",
                f"Qué te parece esta 👇\n\n\"{rule_es}\"\n\n¿La usamos?",
            ]
            text = presentations[rn % len(presentations)]

            session["msgs"].append({"role": "user", "content": message})
            session["msgs"].append({"role": "assistant", "content": text})
            session["_pending_rule"] = {"es": rule_es, "en": rule_en}
            _sessions[session_id] = session
            return _build_response(session, text)

        if len(confirmed) >= 3:
            session["phase"] = EvaPhase.CONFIRM.value

    # ═══ CONFIRM ═══
    if session["phase"] == EvaPhase.CONFIRM.value:
        zone = session.get("zone", "")
        rules = session.get("confirmed_rules", [])
        rules_text = "\n".join([f"  {i+1}. {r.get('es', r) if isinstance(r, dict) else r}" for i, r in enumerate(rules)])
        first = session.get("owner_name", "amigo").split()[0]
        if old_phase != EvaPhase.CONFIRM.value:
            text = (f"{first}, esto es lo que quedó configurado:\n\n"
                    f"📷 Cámara: Cámara {zone}\n📍 Zona: {zone}\n"
                    f"🕐 Horario: {session.get('schedule', {}).get('open', '08:00')} a {session.get('schedule', {}).get('close', '22:00')}\n"
                    f"🌙 Fuera de horario: alerta inmediata\n\nReglas:\n{rules_text}\n\n¿Apruebas esta configuración?")
        else:
            if _is_yes(message):
                saved = _save_config(session, user_id, storage_root)
                session["phase"] = EvaPhase.DONE.value
                text = "🎉 ¡Listo! Tu cámara está configurada y vigilando.\n\nTe avisaré si detecto algo sospechoso." if saved else "⚠️ Configuración casi lista."
            else:
                session["phase"] = EvaPhase.RULES.value
                text = "Entendido. ¿Qué quieres cambiar?"
        session["msgs"].append({"role": "user", "content": message})
        session["msgs"].append({"role": "assistant", "content": text})
        _sessions[session_id] = session
        return _build_response(session, text)

    # ═══ DONE ═══
    if session["phase"] == EvaPhase.DONE.value:
        text = "Tu cámara ya está vigilando. Si necesitas algo más, avísame."
        session["msgs"].append({"role": "user", "content": message})
        session["msgs"].append({"role": "assistant", "content": text})
        _sessions[session_id] = session
        return _build_response(session, text)

    # ═══ Fallback ═══
    sys_p = "Eres Eva, asistente de seguridad de OjoIA. Dominicana, cercana. Máximo 3 líneas."
    msgs = [{"role": "system", "content": sys_p}]
    msgs.extend(session["msgs"][-MAX_HISTORY:])
    msgs.append({"role": "user", "content": message})
    text = (await _qwen(msgs, MAX_TOKENS)).strip()
    session["msgs"].append({"role": "user", "content": message})
    session["msgs"].append({"role": "assistant", "content": text})
    _sessions[session_id] = session
    return _build_response(session, text)
